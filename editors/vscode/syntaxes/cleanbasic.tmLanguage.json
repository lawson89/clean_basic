{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CleanBasic",
  "scopeName": "source.cleanbasic",
    "patterns": [
    { "include": "#bytes" },
    { "include": "#interpolated-strings" },
    { "include": "#strings" },
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.cleanbasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.number-sign.cleanbasic",
          "match": "#.*$"
        }
      ]
    },
    "bytes": {
      "name": "string.quoted.double.byte.cleanbasic",
      "begin": "\\b[bB]\"",
      "end": "\"|(?=$)",
      "patterns": [
        {
          "name": "constant.character.escape.cleanbasic",
          "match": "\\\\(?:x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    "interpolated-strings": {
      "name": "string.quoted.double.interpolated.cleanbasic",
      "begin": "\\$\"",
      "end": "\"|(?=$)",
      "patterns": [
        {
          "name": "constant.character.escape.cleanbasic",
          "match": "\\\\.|\\{\\{|\\}\\}"
        },
        {
          "name": "meta.embedded.line.cleanbasic",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.cleanbasic" }
          },
          "end": "\\}|(?=$)",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.cleanbasic" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cleanbasic",
      "begin": "\"",
      "end": "\"|(?=$)",
      "patterns": [
        {
          "name": "constant.character.escape.cleanbasic",
          "match": "\\\\."
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.function.cleanbasic" },
            "2": { "name": "entity.name.function.cleanbasic" }
          }
        },
        {
          "match": "\\b(type|alias|enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.type.cleanbasic" },
            "2": { "name": "entity.name.type.cleanbasic" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.multiword.cleanbasic",
          "match": "\\b(?:import\\s+header|import\\s+link|select\\s+case|case\\s+else|end\\s+select|else\\s+if|end\\s+if|end\\s+fn|end\\s+type|end\\s+enum|end\\s+union|end\\s+for|end\\s+while|end\\s+defer|end\\s+try|can\\s+error)\\b"
        },
        {
          "name": "keyword.control.cleanbasic",
          "match": "\\b(?:import|as|public|private|extern|type|alias|enum|union|fn|return|if|else|while|for|until|to|step|in|case|try|catch|defer|break|continue)\\b"
        },
        {
          "name": "storage.modifier.cleanbasic",
          "match": "\\b(?:dim|const|byref)\\b"
        },
        {
          "name": "keyword.operator.logical.cleanbasic",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.cleanbasic",
          "match": "\\b(?:int|float|str|bool|cptr|err|bytes|list|dict)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.cleanbasic",
          "match": "\\b(?:print|error)(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.method.cleanbasic",
          "match": "\\.(?:len|toStr|toInt|toFloat|push|pop|clear|has|remove|slice|sliceFrom|toUtf8|toBytes|toHex|fromHex|readU16Le|readU16Be|readU32Le|readU32Be|readU64Le|readU64Be|writeU16Le|writeU16Be|writeU32Le|writeU32Be|writeU64Le|writeU64Be)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cleanbasic",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.cleanbasic",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cleanbasic",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.cleanbasic",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.cleanbasic",
          "match": "\\b[0-9_]+\\.[0-9_]+\\b"
        },
        {
          "name": "constant.numeric.integer.cleanbasic",
          "match": "\\b[0-9_]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.cleanbasic",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.cleanbasic",
          "match": "\\+=|-=|\\*=|/=|%=|&="
        },
        {
          "name": "keyword.operator.arithmetic.cleanbasic",
          "match": "\\+|-|\\*|/|%|&"
        },
        {
          "name": "keyword.operator.assignment.cleanbasic",
          "match": "="
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.cleanbasic" }
          }
        }
      ]
    }
  }
}
