' CleanBasic Standard Library: std/str
' UTF-8 codepoint-safe string processing, searching, splitting, trimming, slicing, and explicit ascii_* helpers

import header "str/str_bridge.hpp"

' UTF-8 Inspection & Codepoints
extern fn cbStrUtf8Len(s as str) as int
extern fn cbStrUtf8Valid(s as str) as bool
extern fn cbStrChars(s as str) as list[str]

' Search & Match
extern fn cbStrContains(s as str, sub as str) as bool
extern fn cbStrFind(s as str, sub as str) as int
extern fn cbStrRfind(s as str, sub as str) as int
extern fn cbStrCount(s as str, sub as str) as int
extern fn cbStrStartsWith(s as str, prefix as str) as bool
extern fn cbStrEndsWith(s as str, suffix as str) as bool
extern fn cbStrAsciiEqualsIgnoreCase(s as str, other as str) as bool
extern fn cbStrAsciiStartsWithIgnoreCase(s as str, prefix as str) as bool
extern fn cbStrAsciiEndsWithIgnoreCase(s as str, suffix as str) as bool
extern fn cbStrAsciiFindIgnoreCase(s as str, sub as str) as int
extern fn cbStrAsciiRfindIgnoreCase(s as str, sub as str) as int
extern fn cbStrAsciiContainsIgnoreCase(s as str, sub as str) as bool

' Splitting & Joining
extern fn cbStrSplit(s as str, sep as str) as list[str]
extern fn cbStrFields(s as str) as list[str]
extern fn cbStrLines(s as str) as list[str]
extern fn cbStrJoin(parts as list[str], sep as str) as str

' Trimming & Padding
extern fn cbStrTrim(s as str) as str
extern fn cbStrLtrim(s as str) as str
extern fn cbStrRtrim(s as str) as str
extern fn cbStrTrimChars(s as str, chars as str) as str
extern fn cbStrPadLeft(s as str, width as int, pad as str) as str
extern fn cbStrPadRight(s as str, width as int, pad as str) as str

' Slicing & Substrings
extern fn cbStrSlice(s as str, start as int, stop as int) as str
extern fn cbStrSliceFrom(s as str, start as int) as str
extern fn cbStrLeft(s as str, n as int) as str
extern fn cbStrRight(s as str, n as int) as str
extern fn cbStrMid(s as str, start as int, count as int) as str
extern fn cbStrCharAt(s as str, idx as int) as str
extern fn cbStrFromChar(code as int) as str

' Transformations
extern fn cbStrReplace(s as str, oldSub as str, newSub as str) as str
extern fn cbStrReplaceFirst(s as str, oldSub as str, newSub as str) as str
extern fn cbStrAsciiLower(s as str) as str
extern fn cbStrAsciiUpper(s as str) as str
extern fn cbStrRepeat(s as str, n as int) as str
extern fn cbStrReverse(s as str) as str
extern fn cbStrEscapeCpp(s as str) as str
extern fn cbStrUnescape(s as str) as str can error

' Parsing & ASCII Character Classification
extern fn cbStrToInt(s as str) as int can error
extern fn cbStrToFloat(s as str) as float can error
extern fn cbStrToBool(s as str) as bool can error
extern fn cbStrAsciiIsDigit(s as str) as bool
extern fn cbStrAsciiIsAlpha(s as str) as bool
extern fn cbStrAsciiIsSpace(s as str) as bool
extern fn cbStrAsciiIsAlnum(s as str) as bool
extern fn cbStrAsciiIsHexDigit(s as str) as bool

' --- Public API: UTF-8 Inspection & Codepoints ---

'' Returns the number of UTF-8 Unicode codepoints in s.
public fn utf8Len(s as str) as int
    return cbStrUtf8Len(s)
end fn

'' Returns true if s contains strictly valid UTF-8 byte sequences.
public fn utf8Valid(s as str) as bool
    return cbStrUtf8Valid(s)
end fn

'' Splits s into a list of single-codepoint UTF-8 strings.
public fn chars(s as str) as list[str]
    return cbStrChars(s)
end fn

' --- Public API: Search & Match ---

'' Returns true if s contains the substring sub.
public fn contains(s as str, sub as str) as bool
    return cbStrContains(s, sub)
end fn

'' Returns the 0-based byte index of the first occurrence of sub in s, or -1 if not found.
public fn find(s as str, sub as str) as int
    return cbStrFind(s, sub)
end fn

'' Returns the 0-based byte index of the last occurrence of sub in s, or -1 if not found.
public fn rfind(s as str, sub as str) as int
    return cbStrRfind(s, sub)
end fn

'' Returns the number of non-overlapping occurrences of sub in s.
public fn count(s as str, sub as str) as int
    return cbStrCount(s, sub)
end fn

'' Returns true if s begins with prefix.
public fn startsWith(s as str, prefix as str) as bool
    return cbStrStartsWith(s, prefix)
end fn

'' Returns true if s ends with suffix.
public fn endsWith(s as str, suffix as str) as bool
    return cbStrEndsWith(s, suffix)
end fn

'' Returns true if s and other are equal under ASCII case-insensitive comparison.
public fn asciiEqualsIgnoreCase(s as str, other as str) as bool
    return cbStrAsciiEqualsIgnoreCase(s, other)
end fn

'' Returns true if s starts with prefix under ASCII case-insensitive comparison.
public fn asciiStartsWithIgnoreCase(s as str, prefix as str) as bool
    return cbStrAsciiStartsWithIgnoreCase(s, prefix)
end fn

'' Returns true if s ends with suffix under ASCII case-insensitive comparison.
public fn asciiEndsWithIgnoreCase(s as str, suffix as str) as bool
    return cbStrAsciiEndsWithIgnoreCase(s, suffix)
end fn

'' Returns the 0-based byte index of the first ASCII case-insensitive match of sub in s, or -1.
public fn asciiFindIgnoreCase(s as str, sub as str) as int
    return cbStrAsciiFindIgnoreCase(s, sub)
end fn

'' Returns the 0-based byte index of the last ASCII case-insensitive match of sub in s, or -1.
public fn asciiRfindIgnoreCase(s as str, sub as str) as int
    return cbStrAsciiRfindIgnoreCase(s, sub)
end fn

'' Returns true if s contains sub under ASCII case-insensitive comparison.
public fn asciiContainsIgnoreCase(s as str, sub as str) as bool
    return cbStrAsciiContainsIgnoreCase(s, sub)
end fn

' --- Public API: Splitting & Joining ---

'' Splits s by separator sep into a list of substrings (or into UTF-8 codepoints when sep is "").
public fn split(s as str, sep as str) as list[str]
    return cbStrSplit(s, sep)
end fn

'' Splits s on runs of ASCII whitespace, discarding leading/trailing whitespace.
public fn fields(s as str) as list[str]
    return cbStrFields(s)
end fn

'' Splits s into lines on LF or CRLF boundaries.
public fn lines(s as str) as list[str]
    return cbStrLines(s)
end fn

'' Joins a list of strings with separator sep between elements.
public fn join(parts as list[str], sep as str) as str
    return cbStrJoin(parts, sep)
end fn

' --- Public API: Trimming & Padding ---

'' Strips leading and trailing ASCII whitespace from s.
public fn trim(s as str) as str
    return cbStrTrim(s)
end fn

'' Strips leading ASCII whitespace from s.
public fn ltrim(s as str) as str
    return cbStrLtrim(s)
end fn

'' Strips trailing ASCII whitespace from s.
public fn rtrim(s as str) as str
    return cbStrRtrim(s)
end fn

'' Strips leading and trailing UTF-8 codepoints present in chars from s.
public fn trimChars(s as str, chars as str) as str
    return cbStrTrimChars(s, chars)
end fn

'' Pads s on the left with pad up to width UTF-8 codepoints.
public fn padLeft(s as str, width as int, pad as str) as str
    return cbStrPadLeft(s, width, pad)
end fn

'' Pads s on the right with pad up to width UTF-8 codepoints.
public fn padRight(s as str, width as int, pad as str) as str
    return cbStrPadRight(s, width, pad)
end fn

' --- Public API: Slicing & Substrings ---

'' Returns the bounds-clamped byte slice [start, stop) of s.
public fn slice(s as str, start as int, stop as int) as str
    return cbStrSlice(s, start, stop)
end fn

'' Returns the bounds-clamped byte slice of s from start to the end of the string.
public fn sliceFrom(s as str, start as int) as str
    return cbStrSliceFrom(s, start)
end fn

'' Returns the first n UTF-8 codepoints of s.
public fn left(s as str, n as int) as str
    return cbStrLeft(s, n)
end fn

'' Returns the last n UTF-8 codepoints of s.
public fn right(s as str, n as int) as str
    return cbStrRight(s, n)
end fn

'' Returns count UTF-8 codepoints of s starting at codepoint index start.
public fn mid(s as str, start as int, count as int) as str
    return cbStrMid(s, start, count)
end fn

'' Returns the UTF-8 codepoint at codepoint index idx in s, or "" if out of bounds.
public fn charAt(s as str, idx as int) as str
    return cbStrCharAt(s, idx)
end fn

'' Encodes a Unicode scalar value (codepoint) into a UTF-8 string.
public fn fromChar(code as int) as str
    return cbStrFromChar(code)
end fn

' --- Public API: Transformations ---

'' Replaces all occurrences of oldSub in s with newSub.
public fn replace(s as str, oldSub as str, newSub as str) as str
    return cbStrReplace(s, oldSub, newSub)
end fn

'' Replaces the first occurrence of oldSub in s with newSub.
public fn replaceFirst(s as str, oldSub as str, newSub as str) as str
    return cbStrReplaceFirst(s, oldSub, newSub)
end fn

'' Converts all ASCII uppercase bytes ('A'..'Z') in s to lowercase ('a'..'z').
public fn asciiLower(s as str) as str
    return cbStrAsciiLower(s)
end fn

'' Converts all ASCII lowercase bytes ('a'..'z') in s to uppercase ('A'..'Z').
public fn asciiUpper(s as str) as str
    return cbStrAsciiUpper(s)
end fn

'' Repeats string s n times.
public fn repeat(s as str, n as int) as str
    return cbStrRepeat(s, n)
end fn

'' Reverses s by UTF-8 codepoints without corrupting multi-byte sequences.
public fn reverse(s as str) as str
    return cbStrReverse(s)
end fn

'' Escapes special characters in s for safe inclusion in C++ string literals.
public fn escapeCpp(s as str) as str
    return cbStrEscapeCpp(s)
end fn

'' Unescapes standard backslash escape sequences (\n, \t, \r, \, ", \xHH) in s.
public fn unescape(s as str) as str can error
    return cbStrUnescape(s)
end fn

' --- Public API: Parsing & ASCII Character Classification ---

'' Parses a decimal, hex (0x), or binary (0b) integer from s, raising an error if invalid.
public fn toInt(s as str) as int can error
    return cbStrToInt(s)
end fn

'' Parses a floating-point number from s, raising an error if invalid.
public fn toFloat(s as str) as float can error
    return cbStrToFloat(s)
end fn

'' Parses a boolean ("true"/"false"/"1"/"0") from s, raising an error if invalid.
public fn toBool(s as str) as bool can error
    return cbStrToBool(s)
end fn

'' Returns true if s is non-empty and all bytes are ASCII digits ('0'..'9').
public fn asciiIsDigit(s as str) as bool
    return cbStrAsciiIsDigit(s)
end fn

'' Returns true if s is non-empty and all bytes are ASCII letters ('a'..'z', 'A'..'Z').
public fn asciiIsAlpha(s as str) as bool
    return cbStrAsciiIsAlpha(s)
end fn

'' Returns true if s is non-empty and all bytes are ASCII whitespace.
public fn asciiIsSpace(s as str) as bool
    return cbStrAsciiIsSpace(s)
end fn

'' Returns true if s is non-empty and all bytes are ASCII alphanumeric characters.
public fn asciiIsAlnum(s as str) as bool
    return cbStrAsciiIsAlnum(s)
end fn

'' Returns true if s is non-empty and all bytes are ASCII hexadecimal digits.
public fn asciiIsHexDigit(s as str) as bool
    return cbStrAsciiIsHexDigit(s)
end fn
