' CleanBasic Standard Library: std/test
' Lightweight unit testing runner with assertion failure reporting

'' Represents a single named test case and its callback function.
public type TestCase
    name as str
    runFn as fn() can error
end type

'' Represents a named collection of test cases to execute together.
public type Suite
    name as str
    cases as list[TestCase]
end type

'' Creates a new empty test Suite with the given name.
public fn newSuite(name as str) as Suite
    return Suite(name=name, cases=[])
end fn

'' Registers a named test case function in the suite.
public fn add(byref s as Suite, name as str, runFn as fn() can error)
    s.cases.push(TestCase(name=name, runFn=runFn))
end fn

'' Executes all test cases in the suite, printing PASS/FAIL diagnostics and returning 0 if all pass or 1 if any fail.
public fn run(byref s as Suite) as int
    print("Running suite: " & s.name)
    dim passed = 0
    dim failed = 0
    for tc in s.cases
        try
            tc.runFn()
            print("  [PASS] " & tc.name)
            passed = passed + 1
        catch e
            print("  [FAIL] " & tc.name)
            print("         " & e.msg)
            print("         at " & e.file & ":" & e.line.toStr())
            failed = failed + 1
        end try
    end for

    print("Passed: " & passed.toStr() & ", Failed: " & failed.toStr())
    if failed > 0
        return 1
    end if
    return 0
end fn
