' CleanBasic Standard Library: std/fs
' Filesystem I/O, slot-table streaming File handle, metadata, directory, and path utilities

import header "fs/fs_bridge.hpp"

'' Opaque value-semantic handle to an open streaming file slot.
public extern type CbFile
    private handle as int
end type

'' Value-semantic handle to an open streaming file.
public alias File = CbFile

' Whole-file operations
extern fn cbFsRead(path as str) as str can error
extern fn cbFsReadBytes(path as str) as bytes can error
extern fn cbFsWriteBytes(path as str, data as bytes) can error
extern fn cbFsLines(path as str) as list[str] can error
extern fn cbFsWrite(path as str, content as str) can error
extern fn cbFsAppend(path as str, content as str) can error
extern fn cbFsCopy(src as str, dst as str) can error
extern fn cbFsRename(src as str, dst as str) can error

' Streaming File operations
extern fn cbFsStdin() as CbFile
extern fn cbFsStdout() as CbFile
extern fn cbFsStderr() as CbFile
extern fn cbFsOpen(path as str) as CbFile can error
extern fn cbFsOpenMode(path as str, mode as str) as CbFile can error
extern fn cbFsReadLine(f as CbFile, byref outLine as str) as bool can error
extern fn cbFsEof(f as CbFile) as bool
extern fn cbFsWriteStream(f as CbFile, text as str) can error
extern fn cbFsWriteLine(f as CbFile, text as str) can error
extern fn cbFsFlush(f as CbFile) can error
extern fn cbFsIsOpen(f as CbFile) as bool
extern fn cbFsClose(byref f as CbFile)
extern fn cbFsReadFileBytes(f as CbFile, count as int) as bytes can error
extern fn cbFsWriteFileBytes(f as CbFile, data as bytes) can error

' Metadata, directories, and paths
extern fn cbFsExists(path as str) as bool
extern fn cbFsIsFile(path as str) as bool
extern fn cbFsIsDir(path as str) as bool
extern fn cbFsSize(path as str) as int can error
extern fn cbFsDir(path as str) as list[str] can error
extern fn cbFsMkdir(path as str) can error
extern fn cbFsRemove(path as str) can error
extern fn cbFsRemoveAll(path as str) as int can error
extern fn cbFsWalkFiles(path as str, includeHidden as bool) as list[str] can error
extern fn cbFsAbsPath(path as str) as str can error
extern fn cbFsTempDir() as str can error
extern fn cbFsJoinPath(a as str, b as str) as str
extern fn cbFsParentDir(path as str) as str
extern fn cbFsFileName(path as str) as str
extern fn cbFsExt(path as str) as str

' --- Public API: Whole-file operations ---

'' Reads the entire contents of a file at path as a UTF-8 string.
public fn read(path as str) as str can error
    return cbFsRead(path)
end fn

'' Reads all lines of a text file at path into a list of strings (stripping CR/LF).
public fn lines(path as str) as list[str] can error
    return cbFsLines(path)
end fn

'' Writes content to the file at path, creating or truncating the file.
public fn write(path as str, content as str) can error
    cbFsWrite(path, content)
end fn

'' Appends content to the end of the file at path, creating it if needed.
public fn append(path as str, content as str) can error
    cbFsAppend(path, content)
end fn

'' Copies a file from src to dst, overwriting dst if it exists.
public fn copy(src as str, dst as str) can error
    cbFsCopy(src, dst)
end fn

'' Renames or moves a file or directory from src to dst.
public fn rename(src as str, dst as str) can error
    cbFsRename(src, dst)
end fn

'' Reads the entire contents of a binary file at path into a bytes buffer.
public fn readBytes(path as str) as bytes can error
    return cbFsReadBytes(path)
end fn

'' Writes a bytes buffer to the file at path, creating or truncating the file.
public fn writeBytes(path as str, data as bytes) can error
    cbFsWriteBytes(path, data)
end fn

' --- Public API: Streaming File operations (UFCS on File) ---

'' Returns a streaming File handle for standard input (stdin).
public fn stdin() as File
    return cbFsStdin()
end fn

'' Returns a streaming File handle for standard output (stdout).
public fn stdout() as File
    return cbFsStdout()
end fn

'' Returns a streaming File handle for standard error (stderr).
public fn stderr() as File
    return cbFsStderr()
end fn

'' Opens a file at path for reading ("r" mode) and returns a streaming File handle.
public fn open(path as str) as File can error
    return cbFsOpen(path)
end fn

'' Opens a file at path with explicit mode ("r", "w", "a", "rb", "wb", "ab").
public fn openMode(path as str, mode as str) as File can error
    return cbFsOpenMode(path, mode)
end fn

'' Reads the next line from an open File into outLine, returning false on EOF.
public fn readLine(f as File, byref outLine as str) as bool can error
    return cbFsReadLine(f, outLine)
end fn

'' Returns true if the open File has reached end-of-file.
public fn eof(f as File) as bool
    return cbFsEof(f)
end fn

'' Writes raw text to an open File without appending a newline.
public fn writeStr(f as File, text as str) can error
    cbFsWriteStream(f, text)
end fn

'' Writes a line of text followed by a newline to an open File.
public fn writeLine(f as File, text as str) can error
    cbFsWriteLine(f, text)
end fn

'' Flushes buffered output for an open File to disk.
public fn flush(f as File) can error
    cbFsFlush(f)
end fn

'' Returns true if the File handle refers to a currently open stream.
public fn isOpen(f as File) as bool
    return cbFsIsOpen(f)
end fn

'' Closes an open File handle and releases its slot. Safe to call in defer blocks.
public fn close(byref f as File)
    cbFsClose(f)
end fn

'' Reads up to count raw bytes from an open File handle.
public fn readBytes(f as File, count as int) as bytes can error
    return cbFsReadFileBytes(f, count)
end fn

'' Writes a raw bytes buffer to an open File handle.
public fn writeBytes(f as File, data as bytes) can error
    cbFsWriteFileBytes(f, data)
end fn

' --- Public API: Metadata, directories, and paths ---

'' Returns true if a file or directory exists at path.
public fn exists(path as str) as bool
    return cbFsExists(path)
end fn

'' Recursively collects all regular file paths in the directory tree at path.
public fn walkFiles(path as str, includeHidden as bool = false) as list[str] can error
    return cbFsWalkFiles(path, includeHidden)
end fn

'' Returns true if path exists and is a regular file.
public fn isFile(path as str) as bool
    return cbFsIsFile(path)
end fn

'' Returns true if path exists and is a directory.
public fn isDir(path as str) as bool
    return cbFsIsDir(path)
end fn

'' Returns the size in bytes of the file at path.
public fn size(path as str) as int can error
    return cbFsSize(path)
end fn

'' Lists the sorted entry names inside the directory at path.
public fn dir(path as str) as list[str] can error
    return cbFsDir(path)
end fn

'' Creates a directory and any missing parent directories at path.
public fn mkdir(path as str) can error
    cbFsMkdir(path)
end fn

'' Removes a single file or empty directory at path.
public fn remove(path as str) can error
    cbFsRemove(path)
end fn

'' Recursively removes a file or directory tree at path, returning the number of removed entries.
public fn removeAll(path as str) as int can error
    return cbFsRemoveAll(path)
end fn

'' Resolves path to an absolute filesystem path.
public fn absPath(path as str) as str can error
    return cbFsAbsPath(path)
end fn

'' Returns the system temporary directory path.
public fn tempDir() as str can error
    return cbFsTempDir()
end fn

'' Joins two path segments using a normalized '/' separator.
public fn joinPath(a as str, b as str) as str
    return cbFsJoinPath(a, b)
end fn

'' Returns the parent directory portion of path.
public fn parentDir(path as str) as str
    return cbFsParentDir(path)
end fn

'' Returns the final filename component of path.
public fn fileName(path as str) as str
    return cbFsFileName(path)
end fn

'' Returns the file extension of path (including the leading dot, e.g. ".cb"), or "" if none.
public fn ext(path as str) as str
    return cbFsExt(path)
end fn
