' CleanBasic Standard Library: std/os
' CLI arguments, standard streams, environment variables, working directory, platform, clock, sleep, subprocess, and exit

import header "os/os_bridge.hpp"

' CLI & Standard Streams
extern fn cbOsArgs() as list[str]
extern fn cbOsPrintRaw(text as str)
extern fn cbOsEprint(msg as str)
extern fn cbOsEprintRaw(text as str)
extern fn cbOsReadLine(byref outLine as str) as bool
extern fn cbOsReadExact(count as int) as str
extern fn cbOsReadAll() as str

' Environment, Working Directory & Platform
extern fn cbOsEnv(name as str) as str
extern fn cbOsHasEnv(name as str) as bool
extern fn cbOsCwd() as str can error
extern fn cbOsChdir(path as str) can error
extern fn cbOsPlatform() as str
extern fn cbOsExePath() as str

' Timing & Process Control
extern fn cbOsClock() as int
extern fn cbOsSleep(ms as int)
extern fn cbOsRun(cmd as str) as int
extern fn cbOsExec(cmd as str) as str can error
extern fn cbOsExit(code as int)

' --- Public API: CLI & Standard Streams ---

'' Returns the command-line arguments passed to the program (including argv[0]).
public fn args() as list[str]
    return cbOsArgs()
end fn

'' Writes text to standard output without appending a trailing newline and flushes the stream.
public fn printRaw(text as str)
    cbOsPrintRaw(text)
end fn

'' Writes a message to standard error followed by a newline.
public fn eprint(msg as str)
    cbOsEprint(msg)
end fn

'' Writes text to standard error without appending a trailing newline and flushes the stream.
public fn eprintRaw(text as str)
    cbOsEprintRaw(text)
end fn

'' Reads a single line from standard input into outLine, returning false on EOF.
public fn readLine(byref outLine as str) as bool
    return cbOsReadLine(outLine)
end fn

'' Reads up to count bytes from standard input as a string.
public fn readExact(count as int) as str
    return cbOsReadExact(count)
end fn

'' Reads all remaining bytes from standard input until EOF.
public fn readAll() as str
    return cbOsReadAll()
end fn

' --- Public API: Environment, Working Directory & Platform ---

'' Returns the value of environment variable name, or "" if not set.
public fn env(name as str) as str
    return cbOsEnv(name)
end fn

'' Returns true if environment variable name is defined in the process environment.
public fn hasEnv(name as str) as bool
    return cbOsHasEnv(name)
end fn

'' Returns the current working directory path.
public fn cwd() as str can error
    return cbOsCwd()
end fn

'' Changes the current working directory to path.
public fn chdir(path as str) can error
    cbOsChdir(path)
end fn

'' Returns the host operating system identifier ("linux", "macos", "windows", or "unknown").
public fn platform() as str
    return cbOsPlatform()
end fn

'' Returns the resolved filesystem path of the currently running executable, or "" if unavailable.
public fn exePath() as str
    return cbOsExePath()
end fn

' --- Public API: Timing & Process Control ---

'' Returns a monotonic clock timestamp in milliseconds.
public fn clock() as int
    return cbOsClock()
end fn

'' Suspends execution of the current thread for ms milliseconds.
public fn sleep(ms as int)
    cbOsSleep(ms)
end fn

'' Executes a shell command and returns its exit status code.
public fn run(cmd as str) as int
    return cbOsRun(cmd)
end fn

'' Executes a shell command, captures its standard output, and raises an error if the command fails.
public fn exec(cmd as str) as str can error
    return cbOsExec(cmd)
end fn

'' Terminates the process immediately with the specified exit status code.
public fn exit(code as int)
    cbOsExit(code)
end fn
