' CleanBasic Standard Library: std/json
' Value-semantic RFC 8259 JSON DOM, parser, builder, and serializer

import header "json/json_bridge.hpp"

'' Value-semantic RFC 8259 JSON document owning an internal node arena.
public extern type JsonDoc
end type

'' Lightweight value handle referencing a JSON node inside a JsonDoc.
public extern type JsonVal
end type

extern fn cbJsonNewDoc() as JsonDoc
extern fn cbJsonParse(text as str) as JsonDoc can error
extern fn cbJsonRoot(doc as JsonDoc) as JsonVal
extern fn cbJsonSetRoot(byref doc as JsonDoc, val as JsonVal)
extern fn cbJsonStringify(doc as JsonDoc) as str
extern fn cbJsonStringifyVal(doc as JsonDoc, val as JsonVal) as str

extern fn cbJsonNewObject(byref doc as JsonDoc) as JsonVal
extern fn cbJsonNewArray(byref doc as JsonDoc) as JsonVal
extern fn cbJsonNewStr(byref doc as JsonDoc, val as str) as JsonVal
extern fn cbJsonNewInt(byref doc as JsonDoc, val as int) as JsonVal
extern fn cbJsonNewFloat(byref doc as JsonDoc, val as float) as JsonVal
extern fn cbJsonNewBool(byref doc as JsonDoc, val as bool) as JsonVal
extern fn cbJsonNewNull(byref doc as JsonDoc) as JsonVal
extern fn cbJsonObjectSet(byref doc as JsonDoc, obj as JsonVal, key as str, val as JsonVal)
extern fn cbJsonArrayPush(byref doc as JsonDoc, arr as JsonVal, elem as JsonVal)

extern fn cbJsonHasField(doc as JsonDoc, obj as JsonVal, key as str) as bool
extern fn cbJsonGetField(doc as JsonDoc, obj as JsonVal, key as str) as JsonVal can error
extern fn cbJsonGetStr(doc as JsonDoc, val as JsonVal) as str can error
extern fn cbJsonGetInt(doc as JsonDoc, val as JsonVal) as int can error
extern fn cbJsonGetFloat(doc as JsonDoc, val as JsonVal) as float can error
extern fn cbJsonGetBool(doc as JsonDoc, val as JsonVal) as bool can error
extern fn cbJsonIsNull(doc as JsonDoc, val as JsonVal) as bool
extern fn cbJsonArrayLen(doc as JsonDoc, arr as JsonVal) as int
extern fn cbJsonArrayAt(doc as JsonDoc, arr as JsonVal, index as int) as JsonVal can error
extern fn cbJsonKind(doc as JsonDoc, val as JsonVal) as str
extern fn cbJsonObjectKeys(doc as JsonDoc, obj as JsonVal) as list[str]

'' Creates a new empty JsonDoc ready for building JSON nodes.
public fn newDoc() as JsonDoc
    return cbJsonNewDoc()
end fn

'' Parses an RFC 8259 JSON string into a JsonDoc, raising an error on invalid JSON syntax.
public fn parse(text as str) as JsonDoc can error
    return cbJsonParse(text)
end fn

'' Returns the root JsonVal node of the document.
public fn root(doc as JsonDoc) as JsonVal
    return cbJsonRoot(doc)
end fn

'' Sets the root JsonVal node of the document.
public fn setRoot(byref doc as JsonDoc, val as JsonVal)
    cbJsonSetRoot(doc, val)
end fn

'' Serializes the document root node into a compact JSON string.
public fn stringify(doc as JsonDoc) as str
    return cbJsonStringify(doc)
end fn

'' Serializes a specific JsonVal node within the document into a compact JSON string.
public fn stringifyVal(doc as JsonDoc, val as JsonVal) as str
    return cbJsonStringifyVal(doc, val)
end fn

'' Allocates and returns a new JSON object node in the document.
public fn newObject(byref doc as JsonDoc) as JsonVal
    return cbJsonNewObject(doc)
end fn

'' Allocates and returns a new JSON array node in the document.
public fn newArray(byref doc as JsonDoc) as JsonVal
    return cbJsonNewArray(doc)
end fn

'' Allocates and returns a new JSON string node in the document.
public fn newStr(byref doc as JsonDoc, val as str) as JsonVal
    return cbJsonNewStr(doc, val)
end fn

'' Allocates and returns a new 64-bit integer JSON number node in the document.
public fn newInt(byref doc as JsonDoc, val as int) as JsonVal
    return cbJsonNewInt(doc, val)
end fn

'' Allocates and returns a new floating-point JSON number node in the document.
public fn newFloat(byref doc as JsonDoc, val as float) as JsonVal
    return cbJsonNewFloat(doc, val)
end fn

'' Allocates and returns a new JSON boolean node in the document.
public fn newBool(byref doc as JsonDoc, val as bool) as JsonVal
    return cbJsonNewBool(doc, val)
end fn

'' Allocates and returns a JSON null node in the document.
public fn newNull(byref doc as JsonDoc) as JsonVal
    return cbJsonNewNull(doc)
end fn

'' Sets or overwrites key on a JSON object node with val.
public fn objectSet(byref doc as JsonDoc, obj as JsonVal, key as str, val as JsonVal)
    cbJsonObjectSet(doc, obj, key, val)
end fn

'' Appends elem to the end of a JSON array node.
public fn arrayPush(byref doc as JsonDoc, arr as JsonVal, elem as JsonVal)
    cbJsonArrayPush(doc, arr, elem)
end fn

'' Returns true if obj is a JSON object containing a field named key.
public fn hasField(doc as JsonDoc, obj as JsonVal, key as str) as bool
    return cbJsonHasField(doc, obj, key)
end fn

'' Retrieves the child JsonVal for key on a JSON object, or raises an error if missing.
public fn getField(doc as JsonDoc, obj as JsonVal, key as str) as JsonVal can error
    return cbJsonGetField(doc, obj, key)
end fn

'' Extracts the string value of a JSON string node, or raises an error on type mismatch.
public fn getStr(doc as JsonDoc, val as JsonVal) as str can error
    return cbJsonGetStr(doc, val)
end fn

'' Extracts the 64-bit integer value of a JSON number node, or raises an error on type mismatch.
public fn getInt(doc as JsonDoc, val as JsonVal) as int can error
    return cbJsonGetInt(doc, val)
end fn

'' Extracts the double-precision float value of a JSON number node, or raises an error on type mismatch.
public fn getFloat(doc as JsonDoc, val as JsonVal) as float can error
    return cbJsonGetFloat(doc, val)
end fn

'' Extracts the boolean value of a JSON boolean node, or raises an error on type mismatch.
public fn getBool(doc as JsonDoc, val as JsonVal) as bool can error
    return cbJsonGetBool(doc, val)
end fn

'' Returns true if val is a JSON null node.
public fn isNull(doc as JsonDoc, val as JsonVal) as bool
    return cbJsonIsNull(doc, val)
end fn

'' Returns the number of elements in a JSON array node.
public fn arrayLen(doc as JsonDoc, arr as JsonVal) as int
    return cbJsonArrayLen(doc, arr)
end fn

'' Returns the element at 0-based index in a JSON array node, or raises an error if out of bounds.
public fn arrayAt(doc as JsonDoc, arr as JsonVal, index as int) as JsonVal can error
    return cbJsonArrayAt(doc, arr, index)
end fn

'' Returns the type kind of val ("null", "bool", "int", "float", "str", "array", "object", or "invalid").
public fn kind(doc as JsonDoc, val as JsonVal) as str
    return cbJsonKind(doc, val)
end fn

'' Returns all field keys of a JSON object node in insertion order (or an empty list if not an object).
public fn keys(doc as JsonDoc, obj as JsonVal) as list[str]
    return cbJsonObjectKeys(doc, obj)
end fn
