' CleanBasic Standard Library: std/json
' Value-semantic RFC 8259 JSON DOM, parser, builder, and serializer

import header "json_bridge.hpp"

pub extern type CbJsonDoc
pub extern type CbJsonVal

pub alias JsonDoc = CbJsonDoc
pub alias JsonVal = CbJsonVal

extern fn cbJsonNewDoc() as CbJsonDoc
extern fn cbJsonParse(text as str) as CbJsonDoc can error
extern fn cbJsonRoot(byref doc as CbJsonDoc) as CbJsonVal
extern fn cbJsonSetRoot(byref doc as CbJsonDoc, val as CbJsonVal)
extern fn cbJsonStringify(byref doc as CbJsonDoc) as str
extern fn cbJsonStringifyVal(byref doc as CbJsonDoc, val as CbJsonVal) as str

extern fn cbJsonNewObject(byref doc as CbJsonDoc) as CbJsonVal
extern fn cbJsonNewArray(byref doc as CbJsonDoc) as CbJsonVal
extern fn cbJsonNewStr(byref doc as CbJsonDoc, val as str) as CbJsonVal
extern fn cbJsonNewInt(byref doc as CbJsonDoc, val as int) as CbJsonVal
extern fn cbJsonNewFloat(byref doc as CbJsonDoc, val as float) as CbJsonVal
extern fn cbJsonNewBool(byref doc as CbJsonDoc, val as bool) as CbJsonVal
extern fn cbJsonNewNull(byref doc as CbJsonDoc) as CbJsonVal
extern fn cbJsonObjectSet(byref doc as CbJsonDoc, obj as CbJsonVal, key as str, val as CbJsonVal)
extern fn cbJsonArrayPush(byref doc as CbJsonDoc, arr as CbJsonVal, elem as CbJsonVal)

extern fn cbJsonHasField(byref doc as CbJsonDoc, obj as CbJsonVal, key as str) as bool
extern fn cbJsonGetField(byref doc as CbJsonDoc, obj as CbJsonVal, key as str) as CbJsonVal can error
extern fn cbJsonGetStr(byref doc as CbJsonDoc, val as CbJsonVal) as str can error
extern fn cbJsonGetInt(byref doc as CbJsonDoc, val as CbJsonVal) as int can error
extern fn cbJsonGetFloat(byref doc as CbJsonDoc, val as CbJsonVal) as float can error
extern fn cbJsonGetBool(byref doc as CbJsonDoc, val as CbJsonVal) as bool can error
extern fn cbJsonIsNull(byref doc as CbJsonDoc, val as CbJsonVal) as bool
extern fn cbJsonArrayLen(byref doc as CbJsonDoc, arr as CbJsonVal) as int
extern fn cbJsonArrayAt(byref doc as CbJsonDoc, arr as CbJsonVal, index as int) as CbJsonVal can error

pub fn newDoc() as JsonDoc
    return cbJsonNewDoc()
end fn

pub fn parse(text as str) as JsonDoc can error
    return cbJsonParse(text)
end fn

pub fn root(byref doc as JsonDoc) as JsonVal
    return cbJsonRoot(doc)
end fn

pub fn setRoot(byref doc as JsonDoc, val as JsonVal)
    cbJsonSetRoot(doc, val)
end fn

pub fn stringify(byref doc as JsonDoc) as str
    return cbJsonStringify(doc)
end fn

pub fn stringifyVal(byref doc as JsonDoc, val as JsonVal) as str
    return cbJsonStringifyVal(doc, val)
end fn

pub fn newObject(byref doc as JsonDoc) as JsonVal
    return cbJsonNewObject(doc)
end fn

pub fn newArray(byref doc as JsonDoc) as JsonVal
    return cbJsonNewArray(doc)
end fn

pub fn newStr(byref doc as JsonDoc, val as str) as JsonVal
    return cbJsonNewStr(doc, val)
end fn

pub fn newInt(byref doc as JsonDoc, val as int) as JsonVal
    return cbJsonNewInt(doc, val)
end fn

pub fn newFloat(byref doc as JsonDoc, val as float) as JsonVal
    return cbJsonNewFloat(doc, val)
end fn

pub fn newBool(byref doc as JsonDoc, val as bool) as JsonVal
    return cbJsonNewBool(doc, val)
end fn

pub fn newNull(byref doc as JsonDoc) as JsonVal
    return cbJsonNewNull(doc)
end fn

pub fn objectSet(byref doc as JsonDoc, obj as JsonVal, key as str, val as JsonVal)
    cbJsonObjectSet(doc, obj, key, val)
end fn

pub fn arrayPush(byref doc as JsonDoc, arr as JsonVal, elem as JsonVal)
    cbJsonArrayPush(doc, arr, elem)
end fn

pub fn hasField(byref doc as JsonDoc, obj as JsonVal, key as str) as bool
    return cbJsonHasField(doc, obj, key)
end fn

pub fn getField(byref doc as JsonDoc, obj as JsonVal, key as str) as JsonVal can error
    return cbJsonGetField(doc, obj, key)
end fn

pub fn getStr(byref doc as JsonDoc, val as JsonVal) as str can error
    return cbJsonGetStr(doc, val)
end fn

pub fn getInt(byref doc as JsonDoc, val as JsonVal) as int can error
    return cbJsonGetInt(doc, val)
end fn

pub fn getFloat(byref doc as JsonDoc, val as JsonVal) as float can error
    return cbJsonGetFloat(doc, val)
end fn

pub fn getBool(byref doc as JsonDoc, val as JsonVal) as bool can error
    return cbJsonGetBool(doc, val)
end fn

pub fn isNull(byref doc as JsonDoc, val as JsonVal) as bool
    return cbJsonIsNull(doc, val)
end fn

pub fn arrayLen(byref doc as JsonDoc, arr as JsonVal) as int
    return cbJsonArrayLen(doc, arr)
end fn

pub fn arrayAt(byref doc as JsonDoc, arr as JsonVal, index as int) as JsonVal can error
    return cbJsonArrayAt(doc, arr, index)
end fn
