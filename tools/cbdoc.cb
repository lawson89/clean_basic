' CleanBasic Tool: cbdoc
'' Markdown API documentation generator for CleanBasic (.cb) source files and directories
'' Extracts '' doc-comments paired with public declarations using std/cli, std/fs, and std/str
'
'' Usage:
''   cbdoc [-o <output.md>] [-t <title>] [-p] <target>

import "std/cli"
import "std/fs"
import "std/os"
import "std/str"

'' Represents a documented declaration extracted from a source file.
public type DocEntry
    name as str
    kind as str
    signature as str
    doc as str
end type

'' Extracts the declaration header if it is public or includePrivate is true.
fn extractDeclHeader(line as str, includePrivate as bool) as str
    const t = line.trim()
    if t.startsWith("public ")
        return t
    end if
    if includePrivate
        if t.startsWith("fn ") or t.startsWith("type ") or t.startsWith("enum ") or t.startsWith("union ") or t.startsWith("alias ") or t.startsWith("const ")
            return t
        end if
    end if
    return ""
end fn

'' Parses the declaration kind (e.g., "fn") and identifier name from a header line.
fn parseDeclKindAndName(header as str) as list[str]
    dim work = header
    if work.startsWith("public ")
        work = work.sliceFrom(7).ltrim()
    end if
    if work.startsWith("extern ")
        work = work.sliceFrom(7).ltrim()
    end if

    const kinds as list[str] = ["fn", "type", "enum", "union", "alias", "const"]
    for k in kinds
        const prefix = k & " "
        if work.startsWith(prefix)
            const rest = work.sliceFrom(prefix.len()).ltrim()
            dim endIdx = 0
            while endIdx < rest.len()
                const ch = rest.charAt(endIdx)
                if ch == "(" or ch == " " or ch == "=" or ch == "	"
                    break
                end if
                endIdx += 1
            end while
            const name = rest.slice(0, endIdx)
            return [k, name]
        end if
    end for
    return ["", ""]
end fn

'' Returns true if the declaration kind represents a multi-line block (e.g., type...end type).
fn isBlockDeclKind(header as str, kind as str) as bool
    if kind == "enum" or kind == "union"
        return true
    end if
    if kind == "type"
        if header.contains("extern type ")
            return false
        end if
        return true
    end if
    return false
end fn

'' Parses all documented declarations from a .cb file.
fn parseFileDocs(filePath as str, includePrivate as bool) as list[DocEntry] can error
    const lines = fs.lines(filePath)
    dim entries as list[DocEntry] = []
    dim pendingDoc as list[str] = []

    dim i = 0
    while i < lines.len()
        const rawLine = lines[i]
        const trimmed = rawLine.trim()

        if trimmed.startsWith("''")
            dim docLine = trimmed.sliceFrom(2)
            if docLine.startsWith(" ")
                docLine = docLine.sliceFrom(1)
            end if
            pendingDoc.push(docLine)
            i += 1
            continue
        end if

        const header = extractDeclHeader(trimmed, includePrivate)
        if header != ""
            const kindAndName = parseDeclKindAndName(header)
            const kind = kindAndName[0]
            const name = kindAndName[1]
            if kind != "" and name != ""
                dim sigLines as list[str] = [trimmed]
                if isBlockDeclKind(header, kind)
                    const endMarker = $"end {kind}"
                    i += 1
                    while i < lines.len()
                        const bodyTrimmed = lines[i].trim()
                        if includePrivate or not bodyTrimmed.startsWith("private ")
                            sigLines.push(lines[i])
                        end if
                        if bodyTrimmed == endMarker
                            break
                        end if
                        i += 1
                    end while
                end if
                if header.startsWith("public ") or pendingDoc.len() > 0
                    entries.push(DocEntry(
                        name=name,
                        kind=kind,
                        signature=str.join(sigLines, "\n"),
                        doc=str.join(pendingDoc, "\n")
                    ))
                end if
            end if
            pendingDoc.clear()
            i += 1
            continue
        end if

        pendingDoc.clear()
        i += 1
    end while

    return entries
end fn

'' Recursively collects all .cb files within targetPath.
fn collectCbFiles(targetPath as str) as list[str] can error
    if fs.isFile(targetPath)
        dim res as list[str] = []
        if fs.ext(targetPath) == ".cb"
            res.push(targetPath)
        end if
        return res
    end if

    dim outFiles as list[str] = []
    for path in fs.walkFiles(targetPath)
        if fs.ext(path) == ".cb"
            outFiles.push(path)
        end if
    end for
    return outFiles
end fn

'' Renders a module section in Markdown format.
fn renderFileSection(filePath as str, entries as list[DocEntry]) as str
    const tick = str.fromChar(96)
    const fence = tick.repeat(3)
    dim out as list[str] = []
    out.push($"## Module {tick}{filePath}{tick}")
    out.push("")
    for entry in entries
        out.push($"### {tick}{entry.name}{tick} ({entry.kind})")
        out.push("")
        out.push($"{fence}vb")
        out.push(entry.signature)
        out.push(fence)
        if entry.doc != ""
            out.push("")
            out.push(entry.doc)
        end if
        out.push("")
    end for
    return str.join(out, "\n")
end fn

'' Configures the CLI parser for cbdoc.
fn buildParser() as cli.Parser
    dim p = cli.newParser(
        name="cbdoc",
        version="1.0",
        description="Generate Markdown API documentation from CleanBasic '' doc-comments"
    )
    p.addOption("output", "o", "Write generated Markdown to file instead of stdout")
    p.addOption("title", "t", "Document title heading", defaultVal="CleanBasic API Reference")
    p.addFlag("include-private", "p", "Include documented private declarations")
    p.addArg("target", "CleanBasic .cb file or directory to document", required=true)
    return p
end fn

'' Entry point for cbdoc.
fn main() as int
    dim p = buildParser()

    try
        const args = p.parse()
        if args.helpRequested
            p.printUsage()
            return 0
        end if
        if args.versionRequested
            print("cbdoc 1.0")
            return 0
        end if

        const target = args.get("target")
        if not fs.exists(target)
            os.eprint($"cbdoc: {target}: No such file or directory")
            return 1
        end if

        const files = collectCbFiles(target)

        const title = args.get("title", "CleanBasic API Reference")
        const includePrivate = args.has("include-private")
        dim sections as list[str] = [$"# {title}", ""]

        for fpath in files
            const entries = parseFileDocs(fpath, includePrivate)
            if entries.len() > 0
                sections.push(renderFileSection(fpath, entries))
            end if
        end for

        const markdown = str.join(sections, "\n").rtrim() & "\n"
        const outPath = args.get("output", "")
        if outPath != ""
            fs.write(outPath, markdown)
        else
            os.printRaw(markdown)
        end if
        return 0
    catch e
        os.eprint($"cbdoc: {e.msg}")
        os.eprint(p.usage())
        return 2
    end try
end fn
