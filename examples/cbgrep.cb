' CleanBasic Example: cbgrep
' Fast Unix grep / ripgrep-style CLI utility written in pure CleanBasic
' Demonstrates std/cli, std/os, std/fs (streaming File + defer + on error), UFCS, and the std/str prelude
'
' Usage:
'   cbgrep [-icnv] <pattern> [path...]

import "std/cli"
import "std/os"
import "std/fs"

type GrepOptions
    pattern as str
    ignoreCase as bool = false
    lineNumbers as bool = false
    countOnly as bool = false
    invertMatch as bool = false
end type

fn matchesLine(opts as GrepOptions, line as str) as bool
    dim matched = false
    if opts.ignoreCase
        matched = line.asciiContainsIgnoreCase(opts.pattern)
    else
        matched = line.contains(opts.pattern)
    end if
    if opts.invertMatch
        return not matched
    end if
    return matched
end fn

fn formatMatch(opts as GrepOptions, path as str, showPath as bool, lineNum as int, line as str) as str
    if showPath and opts.lineNumbers
        return $"{path}:{lineNum}:{line}"
    else if showPath
        return $"{path}:{line}"
    else if opts.lineNumbers
        return $"{lineNum}:{line}"
    end if
    return line
end fn

fn recordMatch(opts as GrepOptions, path as str, showPath as bool, lineNum as int, line as str, byref matchedCount as int)
    matchedCount += 1
    if not opts.countOnly
        print(opts.formatMatch(path, showPath, lineNum, line))
    end if
end fn

fn printCount(opts as GrepOptions, path as str, showPath as bool, matchedCount as int)
    if not opts.countOnly
        return
    end if
    if showPath
        print($"{path}:{matchedCount}")
    else
        print(matchedCount)
    end if
end fn

fn searchStdin(opts as GrepOptions, showPath as bool) as int
    dim matchedCount = 0
    dim lineNum = 0
    dim line = ""
    while os.readLine(line)
        lineNum += 1
        if opts.matchesLine(line)
            opts.recordMatch("(standard input)", showPath, lineNum, line, matchedCount)
        end if
    end while
    opts.printCount("(standard input)", showPath, matchedCount)
    return matchedCount
end fn

fn searchFile(path as str, opts as GrepOptions, showPath as bool, byref hadError as bool) as int
    on error e
        os.eprint($"cbgrep: {path}: {e.msg}")
        hadError = true
        return 0
    end error

    dim f = fs.open(path)
    defer
        f.close()
    end defer

    dim matchedCount = 0
    dim lineNum = 0
    dim line = ""
    while f.readLine(line)
        lineNum += 1
        if opts.matchesLine(line)
            opts.recordMatch(path, showPath, lineNum, line, matchedCount)
        end if
    end while

    opts.printCount(path, showPath, matchedCount)
    return matchedCount
end fn

fn searchDir(dirPath as str, opts as GrepOptions, byref hadError as bool) as int
    on error e
        os.eprint($"cbgrep: {dirPath}: {e.msg}")
        hadError = true
        return 0
    end error

    dim total = 0
    const entries = fs.dir(dirPath)
    for name in entries
        if name.startsWith(".")
            continue
        end if
        const childPath = fs.joinPath(dirPath, name)
        if fs.isDir(childPath)
            total += searchDir(childPath, opts, hadError)
        else if fs.isFile(childPath)
            total += searchFile(childPath, opts, true, hadError)
        end if
    end for
    return total
end fn

fn buildCliParser() as cli.Parser
    dim p = cli.newParser(name="cbgrep", version="1.0", description="Search for pattern in files or standard input")
    p.addFlag("ignore-case", "i", "Perform case-insensitive ASCII matching")
    p.addFlag("line-number", "n", "Prefix each matching line with its 1-based line number")
    p.addFlag("count", "c", "Print only a count of matching lines per input")
    p.addFlag("invert-match", "v", "Select non-matching lines")
    p.addArg("pattern", "Substring pattern to search for", required=true)
    return p
end fn

fn main() as int
    const p = buildCliParser()

    on error e
        os.eprint($"cbgrep: {e.msg}")
        os.eprint(p.usage())
        return 2
    end error

    const args = p.parse()
    if args.helpRequested
        p.printUsage()
        return 0
    end if
    if args.versionRequested
        print("cbgrep 1.0")
        return 0
    end if

    const opts = GrepOptions(
        pattern=args.get("pattern"),
        ignoreCase=args.has("ignore-case"),
        lineNumbers=args.has("line-number"),
        countOnly=args.has("count"),
        invertMatch=args.has("invert-match")
    )
    const targets = args.rest

    dim totalMatches = 0
    dim hadError = false

    if targets.len() == 0
        totalMatches = searchStdin(opts, false)
    else
        const showPath = targets.len() > 1
        for target in targets
            if target == "-"
                totalMatches += searchStdin(opts, showPath)
            else if not fs.exists(target)
                os.eprint($"cbgrep: {target}: No such file or directory")
                hadError = true
            else if fs.isDir(target)
                totalMatches += searchDir(target, opts, hadError)
            else
                totalMatches += searchFile(target, opts, showPath, hadError)
            end if
        end for
    end if

    if hadError
        return 2
    end if
    if totalMatches > 0
        return 0
    end if
    return 1
end fn
