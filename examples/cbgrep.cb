' CleanBasic Example: cbgrep
' Fast Unix grep / ripgrep-style CLI utility written in pure CleanBasic
' Demonstrates std/cli, std/os, std/fs (streaming File + defer + recursive dir walk), and std/str
'
' Usage:
'   cbgrep [-icnv] <pattern> [path...]

import "std/cli"
import "std/os"
import "std/fs"
import "std/str"

type GrepOptions
    ignoreCase as bool
    lineNumbers as bool
    countOnly as bool
    invertMatch as bool
end type

fn lineMatches(line as str, pattern as str, opts as GrepOptions) as bool
    dim matched = false
    if opts.ignoreCase
        matched = line.asciiContainsIgnoreCase(pattern)
    else
        matched = line.contains(pattern)
    end if
    if opts.invertMatch
        return not matched
    end if
    return matched
end fn

fn formatMatchLine(path as str, showPath as bool, lineNum as int, line as str, opts as GrepOptions) as str
    if showPath and opts.lineNumbers
        return $"{path}:{lineNum}:{line}"
    else if showPath
        return $"{path}:{line}"
    else if opts.lineNumbers
        return $"{lineNum}:{line}"
    end if
    return line
end fn

fn printCountResult(path as str, showPath as bool, matchedCount as int)
    if showPath
        print($"{path}:{matchedCount}")
    else
        print(matchedCount)
    end if
end fn

fn handleMatchedLine(path as str, showPath as bool, lineNum as int, line as str, opts as GrepOptions, byref matchedCount as int)
    matchedCount += 1
    if not opts.countOnly
        print(formatMatchLine(path, showPath, lineNum, line, opts))
    end if
end fn

fn searchStdin(pattern as str, opts as GrepOptions, showPath as bool) as int
    dim matchedCount = 0
    dim lineNum = 0
    dim line = ""
    while os.readLine(line)
        lineNum += 1
        if lineMatches(line, pattern, opts)
            handleMatchedLine("(standard input)", showPath, lineNum, line, opts, matchedCount)
        end if
    end while
    if opts.countOnly
        printCountResult("(standard input)", showPath, matchedCount)
    end if
    return matchedCount
end fn

fn searchFile(path as str, pattern as str, opts as GrepOptions, showPath as bool) as int can error
    dim f = fs.open(path)
    defer
        f.close()
    end defer

    dim matchedCount = 0
    dim lineNum = 0
    dim line = ""
    while f.readLine(line)
        lineNum += 1
        if lineMatches(line, pattern, opts)
            handleMatchedLine(path, showPath, lineNum, line, opts, matchedCount)
        end if
    end while

    if opts.countOnly
        printCountResult(path, showPath, matchedCount)
    end if
    return matchedCount
end fn

fn searchFileSafe(path as str, pattern as str, opts as GrepOptions, showPath as bool, byref hadError as bool) as int
    on error e
        os.eprint($"cbgrep: {path}: {e.msg}")
        hadError = true
        return 0
    end error

    return searchFile(path, pattern, opts, showPath)
end fn

fn searchDir(dirPath as str, pattern as str, opts as GrepOptions, byref hadError as bool) as int
    on error e
        os.eprint($"cbgrep: {dirPath}: {e.msg}")
        hadError = true
        return 0
    end error

    dim total = 0
    dim entries = fs.dir(dirPath)
    for name in entries
        if name.startsWith(".")
            continue
        end if
        dim childPath = fs.joinPath(dirPath, name)
        if fs.isDir(childPath)
            total += searchDir(childPath, pattern, opts, hadError)
        else if fs.isFile(childPath)
            total += searchFileSafe(childPath, pattern, opts, true, hadError)
        end if
    end for
    return total
end fn

fn buildCliParser() as cli.Parser
    dim p = cli.newParser(name="cbgrep", version="1.0", description="Search for pattern in files or standard input")
    p.addFlag("ignore-case", "i", "Perform case-insensitive ASCII matching")
    p.addFlag("line-number", "n", "Prefix each matching line with its 1-based line number")
    p.addFlag("count", "c", "Print only a count of matching lines per input")
    p.addFlag("invert-match", "v", "Select non-matching lines")
    p.addArg("pattern", "Substring pattern to search for", required=true)
    return p
end fn

fn main() as int
    dim p = buildCliParser()

    on error e
        os.eprint($"cbgrep: {e.msg}")
        os.eprint(p.usage())
        return 2
    end error

    dim args = p.parse()
    if args.helpRequested
        p.printUsage()
        return 0
    end if
    if args.versionRequested
        print("cbgrep 1.0")
        return 0
    end if

    dim opts = GrepOptions(
        ignoreCase=args.has("ignore-case"),
        lineNumbers=args.has("line-number"),
        countOnly=args.has("count"),
        invertMatch=args.has("invert-match")
    )
    dim pattern = args.get("pattern")
    dim targets = args.rest

    dim totalMatches = 0
    dim hadError = false

    if targets.len() == 0
        totalMatches = searchStdin(pattern, opts, false)
    else
        dim showPath = targets.len() > 1
        for target in targets
            if target == "-"
                totalMatches += searchStdin(pattern, opts, showPath)
            else if not fs.exists(target)
                os.eprint($"cbgrep: {target}: No such file or directory")
                hadError = true
            else if fs.isDir(target)
                totalMatches += searchDir(target, pattern, opts, hadError)
            else
                totalMatches += searchFileSafe(target, pattern, opts, showPath, hadError)
            end if
        end for
    end if

    if hadError
        return 2
    end if
    if totalMatches > 0
        return 0
    end if
    return 1
end fn
