' CleanBasic Example: cbgrep
' Fast simple grep utility written in pure CleanBasic
' Demonstrates std/cli, std/os, std/fs (walkFiles + streaming), and error handling.

import "std/cli"
import "std/os"
import "std/fs"


fn matchLine(line as str, pattern as str, ignoreCase as bool, lineNumbers as bool, invert as bool, countOnly as bool, source as str, lineNum as int) as bool
    dim matched = false
    if ignoreCase
        matched = line.asciiContainsIgnoreCase(pattern)
    else
        matched = line.contains(pattern)
    end if

    if invert
        matched = not matched
    end if

    if matched
        if not countOnly
            if lineNumbers
                print($"{source}:{lineNum.toStr()}:{line}")
            else
                print($"{source}:{line}")
            end if
        end if
    end if
    return matched
end fn


' Searches for matches in a file or standard input.
fn search(path as str, pattern as str, ignoreCase as bool, lineNumbers as bool, invert as bool, countOnly as bool) as int can error
    dim lineNum = 0
    dim matchCount = 0
    dim line = ""
    
    if path == "-"
        while os.readLine(line)
            lineNum += 1
            dim matched = matchLine(line, pattern, ignoreCase, lineNumbers, invert, countOnly, "{stdout}", lineNum)
            if matched
                matchCount += 1
            end if
        end while
    else
        dim f = fs.open(path)
        defer
            f.close()
        end defer
        while f.readLine(line)
            lineNum += 1
            dim matched = matchLine(line, pattern, ignoreCase, lineNumbers, invert, countOnly, path, lineNum)
            if matched
                matchCount += 1
            end if
        end while
    end if

    if countOnly
        if path != "-"
            print($"{path}:{matchCount.toStr()}")
        else
            print(matchCount.toStr())
        end if
    end if

    return matchCount
end fn

fn main() as int
    dim p = cli.newParser(name="cbgrep", version="1.0", description="Search for pattern in files")
    p.addFlag("ignore-case", "i", "Case-insensitive search")
    p.addFlag("line-number", "n", "Show line numbers")
    p.addFlag("count", "c", "Only show a count of matching lines")
    p.addFlag("invert-match", "v", "Invert match: select non-matching lines")
    p.addArg("pattern", "Search pattern", required=true)

    on error e
        os.eprint("cbgrep: " & e.msg)
        return 2
    end error

    const args = p.parse()
    if args.helpRequested
        p.printUsage()
        return 0
    end if

    const pattern = args.get("pattern")
    const ignoreCase = args.has("ignore-case")
    const lineNumbers = args.has("line-number")
    const countOnly = args.has("count")
    const invert = args.has("invert-match")

    dim targets = args.rest
    if targets.len() == 0
        targets.push("-")
    end if

    dim totalMatches = 0
    for target in targets
        on error e
            os.eprint("cbgrep: " & target & ": " & e.msg)
            continue
        end error

        if target == "-"
            dim mStdn = search("-", pattern, ignoreCase, lineNumbers, invert, countOnly)
            totalMatches += mStdn
        else if fs.isDir(target)
            dim files = fs.walkFiles(target)
            for path in files
                if path.contains("/.") or fs.fileName(path).startsWith(".")
                    continue
                end if
                on error e2
                    os.eprint("cbgrep: " & path & ": " & e2.msg)
                    continue
                end error
                dim mFile = search(path, pattern, ignoreCase, lineNumbers, invert, countOnly)
                totalMatches += mFile
            end for
        else
            dim mTarget = search(target, pattern, ignoreCase, lineNumbers, invert, countOnly)
            totalMatches += mTarget
        end if
    end for

    if totalMatches > 0
        return 0
    end if
    return 1
end fn
