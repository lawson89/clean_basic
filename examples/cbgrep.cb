' CleanBasic Example: cbgrep
' Fast simple grep utility written in pure CleanBasic
' Demonstrates std/cli, std/os, std/fs (walkFiles + streaming), and error handling.

import "std/cli"
import "std/os"
import "std/fs"

'' Searches for matches in a file or standard input and returns the number of matching lines.
fn search(path as str, args as cli.Args) as int can error
    const pattern = args.get("pattern")
    const ignoreCase = args.has("ignore-case")
    const lineNumbers = args.has("line-number")
    const countOnly = args.has("count")
    const invert = args.has("invert-match")

    dim f = fs.stdin()
    dim source = "{stdin}"
    if path != "-"
        f = fs.open(path)
        source = path
    end if
    defer
        f.close()
    end defer

    dim lineNum = 0
    dim matchCount = 0
    dim line = ""
    while f.readLine(line)
        lineNum += 1
        dim matched = false
        if ignoreCase
            matched = line.asciiContainsIgnoreCase(pattern)
        else
            matched = line.contains(pattern)
        end if

        if matched != invert
            matchCount += 1
            if not countOnly
                if lineNumbers
                    print($"{source}:{lineNum}:{line}")
                else
                    print($"{source}:{line}")
                end if
            end if
        end if
    end while

    if countOnly
        print($"{source}:{matchCount}")
    end if

    return matchCount
end fn

'' CLI entry point for cbgrep.
fn main() as int
    dim p = cli.newParser(name="cbgrep", version="1.0", description="Search for pattern in files")
    p.addFlag("ignore-case", "i", "Case-insensitive search")
    p.addFlag("line-number", "n", "Show line numbers")
    p.addFlag("count", "c", "Only show a count of matching lines")
    p.addFlag("invert-match", "v", "Invert match: select non-matching lines")
    p.addArg("pattern", "Search pattern", required=true)

    on error e
        os.eprint($"cbgrep: {e.msg}")
        return 2
    end error

    const args = p.parse()
    if args.helpRequested
        p.printUsage()
        return 0
    end if
    if args.versionRequested
        print("cbgrep 1.0")
        return 0
    end if

    dim targets = args.rest
    if targets.len() == 0
        targets.push("-")
    end if

    dim totalMatches = 0
    for target in targets
        on error e
            os.eprint($"cbgrep: {target}: {e.msg}")
            continue
        end error

        if fs.isDir(target)
            for path in fs.walkFiles(target)
                on error e2
                    os.eprint($"cbgrep: {path}: {e2.msg}")
                    continue
                end error
                totalMatches += search(path, args)
            end for
        else
            totalMatches += search(target, args)
        end if
    end for

    if totalMatches > 0
        return 0
    end if
    return 1
end fn
