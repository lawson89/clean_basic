' EXPECT_CPP: cbStampError
' EXPECT_CPP: cbAssertCond
' EXPECT_CPP: std::function<
' EXPECT_OUT: Running suite: Standard Library Tests
' EXPECT_OUT:   [PASS] assert & fn types
' EXPECT_OUT:   [PASS] assert fail diagnostics
' EXPECT_OUT:   [PASS] custom message & stdlib stamp
' EXPECT_OUT: Passed: 3, Failed: 0

import "std/test"

fn addInts(a as int, b as int) as int
    return a + b
end fn

fn mulInts(a as int, b as int) as int
    return a * b
end fn

fn applyOp(op as fn(int, int) as int, x as int, y as int) as int
    return op(x, y)
end fn

fn addInPlace(byref target as int, delta as int)
    target += delta
end fn

fn testAssert() can error
    assert(1 == 1)
    assert(2 + 2 == 4)

    dim op as fn(int, int) as int = addInts
    assert(op(10, 20) == 30)
    assert(applyOp(mulInts, 6, 7) == 42)

    dim mut as fn(byref int, int) = addInPlace
    dim counter = 10
    mut(counter, 15)
    assert(counter == 25)
end fn

fn testAssertFail() can error
    try
        assert(1 == 2)
    catch e
        assert(e.msg == "Assertion failed")
        assert(e.file.contains("stdlib_test.cb"))
        assert(e.line > 0)
        return
    end try
end fn

fn testCustomMsg() can error
    try
        assert(false, "custom message")
    catch e
        assert(e.msg == "custom message")
        assert(e.file.contains("stdlib_test.cb"))
        assert(e.line > 0)
        return
    end try
end fn

fn main() as int
    dim s = test.newSuite("Standard Library Tests")
    s.add("assert & fn types", testAssert)
    s.add("assert fail diagnostics", testAssertFail)
    s.add("custom message & stdlib stamp", testCustomMsg)
    return s.run()
end fn
