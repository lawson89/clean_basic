' EXPECT_CPP: struct Point {
' EXPECT_CPP: int64_t x{};
' EXPECT_CPP: int64_t y{};
' EXPECT_CPP: pt.x
' FORBID_CPP: class Point
' EXPECT_OUT: 1
' EXPECT_OUT: 25

type Point
    x as int
    y as int
end type

fn main()
    dim pt = Point(1, 2)
    print(pt.x.toStr())
    pt.x = 10
    pt.y = 15
    print((pt.x + pt.y).toStr())
end fn
