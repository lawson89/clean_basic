import "player.cb"

fn main()
    ' IMMUTABILITY: Cannot be changed after declaration
    const maxPotion as int = 50

    ' MUTABILITY & INFERENCE: 'dim' allows reassignment, type is inferred
    dim usesLeft = 3
    usesLeft = 2

    ' MEMORY: Stack allocation (flat, fast, zero cleanup needed)
    dim stackHero = player.Player(name="Alice", health=10)

    ' UFCS (Unified Function Call Syntax):
    stackHero.heal(maxPotion)

    print(stackHero.name, ": ", stackHero.health)
    print("usesLeft: " & usesLeft)
end fn
