' EXPECT_CPP: struct Player {
' EXPECT_CPP: void heal(Player& p, int amount)
' EXPECT_CPP: const int max_potion = 50;
' EXPECT_CPP: int uses_left = 3;
' EXPECT_CPP: uses_left = 2;
' EXPECT_CPP: Player stack_hero = Player{std::string("Alice"), 10};
' EXPECT_CPP: std::shared_ptr<Player> heap_hero = std::make_shared<Player>(Player{std::string("Bob"), 10});
' EXPECT_CPP: heal(stack_hero, max_potion);
' EXPECT_CPP: heal((*heap_hero), max_potion);
' FORBID_CPP: throw
' EXPECT_OUT: Alice: 60
' EXPECT_OUT: Bob: 60
' EXPECT_OUT: uses_left: 2

import "player.cb"

fn main()
    ' IMMUTABILITY: Cannot be changed after declaration
    const max_potion as int = 50

    ' MUTABILITY & INFERENCE: 'dim' allows reassignment, type is inferred
    dim uses_left = 3
    uses_left = 2

    ' MEMORY: Stack allocation (flat, fast, zero cleanup needed)
    dim stack_hero = player.Player(name="Alice", health=10)

    ' MEMORY: Heap allocation (requires 'shared' and 'new')
    dim heap_hero as shared player.Player = new player.Player(name="Bob", health=10)

    ' UFCS (Unified Function Call Syntax):
    stack_hero.heal(max_potion)

    ' Auto-dereference shared pointer on UFCS byref call:
    heap_hero.heal(max_potion)

    print(stack_hero.name & ": " & str(stack_hero.health))
    print(heap_hero.name & ": " & str(heap_hero.health))
    print("uses_left: " & str(uses_left))
end fn
