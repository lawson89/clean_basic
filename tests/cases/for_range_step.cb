' EXPECT_CPP: for (int i = 0; i <= 10; i += 2) {
' EXPECT_CPP: for (auto& x : nums) {
' FORBID_CPP: throw
' EXPECT_OUT: inclusiveEvens: 30
' EXPECT_OUT: itemsSum: 60

fn sumEvens() as int
    dim total = 0
    for i = 0 to 10 step 2
        total = total + i
    end for
    return total
end fn

fn sumItems() as int
    dim nums as list[int] = [10, 20, 30]
    dim sum = 0
    for x in nums
        sum = sum + x
    end for
    return sum
end fn

fn main()
    print("inclusiveEvens: ", sumEvens())
    print("itemsSum: " & sumItems())
end fn
