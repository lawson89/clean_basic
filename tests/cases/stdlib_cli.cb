' EXPECT_CPP: struct cb_std_cli__Parser
' EXPECT_CPP: struct cb_std_cli__Args
' EXPECT_OUT: Running suite: std/cli Command-Line Parser Tests
' EXPECT_OUT:   [PASS] flags, bundled short flags, and options
' EXPECT_OUT:   [PASS] default option values, getInt, and -- separator
' EXPECT_OUT:   [PASS] helpRequested, versionRequested, and usage formatting
' EXPECT_OUT:   [PASS] error handling for unknown and missing args
' EXPECT_OUT: Passed: 4, Failed: 0

import "std/cli"

fn buildSampleParser() as cli.Parser
    dim p = cli.newParser("cbgrep", "1.0", "Search files for a pattern")
    p.addFlag("ignore-case", "i", "Case-insensitive search")
    p.addFlag("line-number", "n", "Show 1-based line numbers")
    p.addFlag("count", "c", "Show only matching line count")
    p.addFlag("invert-match", "v", "Select non-matching lines")
    p.addOption("output", "o", "Output file path", "stdout")
    p.addOption("max-count", "m", "Maximum matches per file", "100")
    p.addArg("pattern", "Pattern to search for", true)
    return p
end fn

fn testFlagsAndOptions() can error
    dim p = buildSampleParser()
    dim args = p.parseArgs(["-inv", "--output", "results.txt", "-m=25", "needle", "a.cb", "b.cb"])
    assert(args.has("ignore-case"))
    assert(args.has("line-number"))
    assert(args.has("invert-match"))
    assert(not args.has("count"))
    assert(args.get("output") == "results.txt")
    assert(args.get("max-count") == "25")
    dim maxVal = args.getInt("max-count", 0)
    assert(maxVal == 25)
    assert(args.get("pattern") == "needle")
    assert(args.rest.len() == 2)
    assert(args.rest[0] == "a.cb")
    assert(args.rest[1] == "b.cb")
end fn

fn testDefaultsAndDoubleDash() can error
    dim p = buildSampleParser()
    dim args = p.parseArgs(["--output=custom.log", "--", "-v", "-"])
    assert(not args.has("invert-match"))
    assert(args.get("output") == "custom.log")
    assert(args.get("max-count") == "100")
    dim maxVal = args.getInt("max-count", 0)
    assert(maxVal == 100)
    assert(args.get("pattern") == "-v")
    assert(args.rest.len() == 1)
    assert(args.rest[0] == "-")
end fn

fn testHelpAndVersion() can error
    dim p = buildSampleParser()
    dim helpArgs = p.parseArgs(["-h"])
    assert(helpArgs.helpRequested)
    assert(helpArgs.has("help"))

    dim verArgs = p.parseArgs(["--version"])
    assert(verArgs.versionRequested)
    assert(verArgs.has("version"))

    dim u = p.usage()
    assert(u.contains("Usage: cbgrep [options] <pattern>"))
    assert(u.contains("-i, --ignore-case"))
    assert(u.contains("-o, --output <val>"))
    assert(u.contains("(default: stdout)"))
end fn

fn testUnknownFlagError() can error
    dim p = buildSampleParser()
    try
        p.parseArgs(["-z", "needle"])
        assert(false, "Expected unknown option error")
    catch e
        assert(e.msg.contains("Unknown option '-z'"))
        return
    end try
end fn

fn testMissingPositionalError() can error
    dim p = buildSampleParser()
    try
        p.parseArgs(["-i"])
        assert(false, "Expected missing argument error")
    catch e
        assert(e.msg.contains("Missing required argument '<pattern>'"))
        return
    end try
end fn

fn testMissingRequiredOptionError() can error
    dim p = cli.newParser("deploy", "1.0", "Deploy service")
    p.addRequiredOption("env", "e", "Target environment")
    try
        p.parseArgs([])
        assert(false, "Expected missing required option error")
    catch e
        assert(e.msg.contains("Missing required option '--env'"))
        return
    end try
end fn

fn testErrorHandling() can error
    testUnknownFlagError()
    testMissingPositionalError()
    testMissingRequiredOptionError()
end fn

fn main() as int
    print("Running suite: std/cli Command-Line Parser Tests")
    try
        testFlagsAndOptions()
        print("  [PASS] flags, bundled short flags, and options")
        testDefaultsAndDoubleDash()
        print("  [PASS] default option values, getInt, and -- separator")
        testHelpAndVersion()
        print("  [PASS] helpRequested, versionRequested, and usage formatting")
        testErrorHandling()
        print("  [PASS] error handling for unknown and missing args")
        print("Passed: 4, Failed: 0")
        return 0
    catch e
        print("  [FAIL] " & e.msg)
        return 1
    end try
end fn
