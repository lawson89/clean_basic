' EXPECT_CPP: struct Connection {
' EXPECT_CPP: std::tuple<Connection, cb_error> connect(std::string ip)
' EXPECT_CPP: return { Connection{}, cb_error{std::string("IP cannot be empty"), 408} };
' EXPECT_CPP: return { Connection{1}, cb_error{"", 0} };
' EXPECT_CPP: cb_error validate_port(int port)
' EXPECT_CPP: auto [_val2, _err2] = connect(std::string("192.168.1.1"));
' EXPECT_CPP: if (cb_has_error(_err2)) return { {}, _err2 };
' EXPECT_CPP: auto conn = _val2;
' EXPECT_CPP: auto _defer_1 = _defer([&]() {
' EXPECT_CPP: close_connection(conn);
' EXPECT_CPP: auto [_val3, _err3] = process_network();
' EXPECT_CPP: if (cb_has_error(_err3)) {
' EXPECT_CPP: cb_error e = _err3;
' EXPECT_CPP: auto records = _val3;
' FORBID_CPP: try
' FORBID_CPP: catch
' EXPECT_OUT: Closing connection: 1
' EXPECT_OUT: Connected and processed 100 records.
' EXPECT_OUT: Handled empty IP (code=408): IP cannot be empty
' EXPECT_OUT: Handled bad port (code=1): Invalid port 0
' EXPECT_OUT: Multi-call caught (code=408): IP cannot be empty
' EXPECT_OUT: Defer B before error return
' EXPECT_OUT: Defer A before error return

pub type Connection
    id as int
end type

pub fn validate_port(port as int) can error
    if port <= 0
        error("Invalid port ", port)
    end if
end fn

' Function can return a Connection OR an error
pub fn connect(ip as str) as Connection can error
    if ip == ""
        error("IP cannot be empty", code=408)
    end if

    return Connection(id=1)
end fn

pub fn close_connection(conn as Connection)
    print("Closing connection: " & conn.id)
end fn

' Declares 'can error', enabling implicit error bubbling
pub fn process_network() as int can error
    validate_port(8080)

    ' IMPLICIT BUBBLING: If connect fails, process_network immediately returns the error.
    dim conn = connect("192.168.1.1")

    ' DETERMINISTIC CLEANUP: Runs right before the function exits, no matter how.
    defer
        close_connection(conn)
    end defer

    return 100
end fn

fn start_server()
    ' start_server() cannot fail. Register a scope-level 'on error' handler.
    on error e
        print("Failed to start server: " & e)
        return
    end error

    dim records = process_network()
    print("Connected and processed ", records, " records.")
end fn

fn test_failed_connect()
    on error err_obj
        print("Handled empty IP (code=" & err_obj.code & "): " & err_obj.msg)
        return
    end error

    dim bad_conn = connect("")
    print("Unexpected success: " & bad_conn.id)
end fn

fn test_failed_port()
    on error e
        print("Handled bad port (code=" & e.code & "): " & e)
        return
    end error

    validate_port(0)
end fn

fn test_multi_call_and_defer_lifo()
    defer
        print("Defer A before error return")
    end defer

    defer
        print("Defer B before error return")
    end defer

    on error e
        print("Multi-call caught (code=" & e.code & "): " & e.msg)
        return
    end error

    validate_port(8080)
    dim c1 = connect("10.0.0.1")
    dim c2 = connect("")
    print("Unreachable: " & c1.id & ", " & c2.id)
end fn

fn main()
    start_server()
    test_failed_connect()
    test_failed_port()
    test_multi_call_and_defer_lifo()
end fn
