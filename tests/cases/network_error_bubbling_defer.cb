' EXPECT_CPP: struct [[nodiscard]] CbError {
' EXPECT_CPP: struct Connection {
' EXPECT_CPP: [[nodiscard]] std::tuple<Connection, CbError> connect(const std::string& ip)
' EXPECT_CPP: return { Connection{}, CbError{std::string("IP cannot be empty"), 408,
' EXPECT_CPP: return { Connection{1}, CbError{"", 0} };
' EXPECT_CPP: [[nodiscard]] CbError validatePort(int64_t port)
' EXPECT_CPP: auto [_val2, _err2] = connect(std::string("192.168.1.1"));
' EXPECT_CPP: if (cbHasError(_err2)) {
' EXPECT_CPP: auto conn = _val2;
' EXPECT_CPP: auto _defer_1 = cbDefer([&]() {
' EXPECT_CPP: closeConnection(conn);
' EXPECT_CPP: auto [_val4, _err4] = processNetwork();
' EXPECT_CPP: if (cbHasError(_err4)) {
' EXPECT_CPP: CbError e = _catch_err_3;
' EXPECT_CPP: auto records = _val4;
' EXPECT_CPP: do {
' EXPECT_CPP: _catch_err_3 = _err4;
' EXPECT_CPP: cbBytesToUtf8(
' EXPECT_OUT: Closing connection: 1
' EXPECT_OUT: Connected and processed 100 records.
' EXPECT_OUT: Handled empty IP (code=408): IP cannot be empty
' EXPECT_OUT: Handled bad port (code=1): Invalid port 0
' EXPECT_OUT: Multi-call caught (code=408): IP cannot be empty
' EXPECT_OUT: Defer B before error return
' EXPECT_OUT: Defer A before error return
' EXPECT_OUT: Forwarded connection id: 1
' EXPECT_OUT: Fallback connection id: -1
' EXPECT_OUT: Fallible loops & compound: total=5, label=items:ac, mode=fast, decoded=ok
' EXPECT_OUT: innerCaught(neg:-1)|outerCaught(neg:-2)|m1=6|loopCaught(neg:-5)|direct(directRaise:422)|forCont=6

public enum Status
    ok = 10
    bad = 20
end enum

public alias StatusAlias = Status

public enum Mode
    fast
    safe
end enum

public alias ModeAlias = Mode
public alias IntList = list[int]

public type Connection
    id as int
end type

public fn validatePort(port as int) can error
    if port <= 0
        error("Invalid port ", port)
    end if
end fn

' Function can return a Connection OR an error
public fn connect(ip as str) as Connection can error
    if ip == ""
        error("IP cannot be empty", code=408)
    end if

    return Connection(id=1)
end fn

public fn closeConnection(conn as Connection)
    print("Closing connection: " & conn.id)
end fn

' Declares 'can error', enabling implicit error bubbling
public fn processNetwork() as int can error
    validatePort(8080)

    ' IMPLICIT BUBBLING: If connect fails, processNetwork immediately returns the error.
    dim conn = connect("192.168.1.1")

    ' DETERMINISTIC CLEANUP: Runs right before the function exits, no matter how.
    defer
        closeConnection(conn)
    end defer

    return 100
end fn

fn startServer()
    ' startServer() cannot fail. Register a scope-level 'try / catch' handler.
    try
        dim records = processNetwork()
        print("Connected and processed ", records, " records.")
    catch e
        print("Failed to start server: " & e)
        return
    end try
end fn

fn testFailedConnect()
    try
        dim badConn = connect("")
        print("Unexpected success: " & badConn.id)
    catch errObj
        print("Handled empty IP (code=" & errObj.code & "): " & errObj.msg)
        return
    end try
end fn

fn testFailedPort()
    try
        validatePort(0)
    catch e
        print("Handled bad port (code=" & e.code & "): " & e)
        return
    end try
end fn

fn testMultiCallAndDeferLifo()
    defer
        print("Defer A before error return")
    end defer

    defer
        print("Defer B before error return")
    end defer

    try
        validatePort(8080)
        dim c1 = connect("10.0.0.1")
        dim c2 = connect("")
        print("Unreachable: " & c1.id & ", " & c2.id)
    catch e
        print("Multi-call caught (code=" & e.code & "): " & e.msg)
        return
    end try
end fn

public fn forwardConnect(ip as str) as Connection can error
    return connect(ip)
end fn

fn connectWithFallback(ip as str) as Connection
    try
        return forwardConnect(ip)
    catch e
        return Connection(id=-1)
    end try
end fn

fn testDirectReturnFallible()
    try
        dim c = forwardConnect("10.0.0.2")
        print("Forwarded connection id: " & c.id)
        dim fallbackConn = connectWithFallback("")
        print("Fallback connection id: " & fallbackConn.id)
    catch e
        print("Unexpected error: " & e.msg)
        return
    end try
end fn

fn loadItems() as list[str] can error
    return ["ab", "cde"]
end fn

fn countItem(s as str) as int can error
    return s.len()
end fn

fn decodeBytesDirect(raw as bytes) as str can error
    return raw.toUtf8()
end fn

fn parseAndSumMode(raw as bytes, nums as IntList) as ModeAlias can error
    dim decoded = raw.toUtf8()
    dim total = 0
    for b in raw
        total += b
    end for
    for n in nums
        total += n
    end for
    if total > 0 and decoded.len() > 0
        return Mode.fast
    end if
    return Mode.safe
end fn

fn testFallibleLoopsAndCompound() can error
    dim total = 0
    dim label = "items:"
    for item in loadItems()
        dim delta = countItem(item)
        total += delta
        label &= item.left(1)
    end for
    dim m = parseAndSumMode(b"ok", [1, 2])
    dim dec = decodeBytesDirect(b"ok")
    print($"Fallible loops & compound: total={total}, label={label}, mode={m}, decoded={dec}")
end fn

fn mightFail(x as int) as int can error
    if x < 0
        error("neg:" & x.toStr(), code=400)
    end if
    return x * 2
end fn

fn testNestedTryAndControlFlow() as str
    dim log = ""
    ' 1. Nested try/catch where inner catch throws a new error caught by outer catch
    try
        try
            dim a = mightFail(-1)
            log &= "UNREACHABLE_INNER|"
        catch innerErr
            log &= "innerCaught(" & innerErr.msg & ")|"
            dim b = mightFail(-2)
            log &= "UNREACHABLE_AFTER_RETHROW|"
        end try
        log &= "UNREACHABLE_OUTER|"
    catch outerErr
        log &= "outerCaught(" & outerErr.msg & ")|"
    end try

    ' 2. Fallible call inside string select case inside while loop inside try
    try
        dim stepIdx = 0
        while stepIdx < 3
            stepIdx += 1
            select case "mode_" & stepIdx.toStr()
                case "mode_1"
                    dim v1 = mightFail(3)
                    log &= "m1=" & v1.toStr() & "|"
                case "mode_2"
                    if stepIdx == 2
                        dim v2 = mightFail(-5)
                        log &= "m2=" & v2.toStr() & "|"
                    end if
                    log &= "UNREACHABLE_M2|"
                case else
                    log &= "UNREACHABLE_M3|"
            end select
        end while
    catch loopErr
        log &= "loopCaught(" & loopErr.msg & ")|"
    end try

    ' 3. Calling error(...) directly inside try/catch in an infallible function
    try
        if StatusAlias.bad == Status.bad
            error("directRaise", code=422)
        end if
        log &= "UNREACHABLE_DIRECT|"
    catch directErr
        log &= "direct(" & directErr.msg & ":" & directErr.code.toStr() & ")|"
    end try

    ' 4. try / catch inside a for loop using continue in catch
    dim forSum = 0
    for i = -1 to 2
        try
            dim v = mightFail(i)
            forSum += v
        catch e
            continue
        end try
    end for
    log &= "forCont=" & forSum.toStr()

    return log
end fn

fn main()
    startServer()
    testFailedConnect()
    testFailedPort()
    testMultiCallAndDeferLifo()
    testDirectReturnFallible()
    try
        testFallibleLoopsAndCompound()
    catch e
        print("Unexpected error: " & e.msg)
    end try
    print(testNestedTryAndControlFlow())
end fn
