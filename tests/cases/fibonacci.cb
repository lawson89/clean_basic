' EXPECT_CPP: int64_t fibIterative(int64_t n)
' EXPECT_CPP: int64_t fibRecursive(int64_t n)
' FORBID_CPP: std::shared_ptr
' EXPECT_OUT: Iterative Fib(10) = 55
' EXPECT_OUT: Recursive Fib(10) = 55

public fn fibIterative(n as int) as int
    if n <= 0
        return 0
    else if n == 1
        return 1
    end if

    dim a = 0
    dim b = 1
    dim nextVal = 0

    for i = 2 to n
        nextVal = a + b
        a = b
        b = nextVal
    end for

    return b
end fn

public fn fibRecursive(n as int) as int
    if n <= 0
        return 0
    else if n == 1
        return 1
    end if

    return fibRecursive(n - 1) + fibRecursive(n - 2)
end fn

fn main() as int
    const target = 10

    dim iterResult = fibIterative(target)
    print("Iterative Fib(", target, ") = ", iterResult)

    dim recResult = fibRecursive(target)
    print("Recursive Fib(", target, ") = ", recResult)

    return 0
end fn
