fn transitiveInternal(x as int) as int
    return x * 2
end fn

public fn usedPublic(a as int, b as int) as int
    return transitiveInternal(a) + b
end fn

public fn bareRefTarget(v as int) as int
    return v + 1
end fn

public fn unusedPublic(x as int) as int
    return x + 999
end fn

fn unusedPrivate() as int
    return 42
end fn
