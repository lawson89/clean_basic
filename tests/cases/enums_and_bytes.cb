' EXPECT_CPP: enum class HttpMethod : int64_t
' EXPECT_CPP: std::vector<uint8_t>
' EXPECT_CPP: cbBytesReadU16Le(
' EXPECT_OUT: HttpMethod.post toStr: post, toInt: 1
' EXPECT_OUT: FileAccess.readWrite: 3
' EXPECT_OUT: describeMethod GET: GET
' EXPECT_OUT: describeMethod POST: MUTATE
' EXPECT_OUT: describeMethod DELETE: OTHER
' EXPECT_OUT: GIF magic len: 6, hex: 474946383961
' EXPECT_OUT: GIF slice: GIF, sliceFrom: 89a
' EXPECT_OUT: fromHex: deadbeef, len: 4
' EXPECT_OUT: toBytes roundtrip: CleanBasic
' EXPECT_OUT: Invalid UTF-8 rejected: overlong=true, surrogate=true
' EXPECT_OUT: Endian U16Le: 4660, U16Be: 4660, U32Le: 287454020
' EXPECT_OUT: Whole file bytes match: true
' EXPECT_OUT: Streamed bytes match: aabb and ccdd
' EXPECT_OUT: Numerics & bitwise: hex=255, bin=165, sep=1000000, and=15, or=255, xor=240, shl=1024, shr=16
' EXPECT_OUT: Union kinds & match: number:42 | add(10,20) | label:start | fallback
' EXPECT_OUT: Interp basic: Method=post, code=1, sum=30, ok=true
' EXPECT_OUT: Interp braces & nested: {post: 200} / dict=42

import "std/fs"

enum HttpMethod
    get
    post
    put
    delete
end enum

enum FileAccess
    read = 0b0001
    write = 0b0010
    readWrite = 0x03
end enum

type NumberLit
    val as int
end type

type BinaryOpNode
    op as str
    left as int
    right as int
end type

union ExprItem
    number as NumberLit
    binary as BinaryOpNode
    label as str
    empty as int
end union

fn evalExprItem(e as ExprItem) as str
    select case e
        case number as numLit
            return e.kind() & ":" & numLit.val.toStr()
        case binary as binOp
            return binOp.op & "(" & binOp.left.toStr() & "," & binOp.right.toStr() & ")"
        case label as lbl
            return e.kind() & ":" & lbl
        case else
            return "fallback"
    end select
end fn

fn testNumericsBitwiseAndUnions()
    dim hx = 0xFF
    dim bn = 0b1010_0101
    dim mil = 1_000_000
    dim bAnd = hx.bitAnd(0x0F)
    dim bOr = (0xF0).bitOr(0x0F)
    dim bXor = hx.bitXor(0x0F)
    dim bShl = (1).shl(10)
    dim bShr = (0x100).shr(4)
    print($"Numerics & bitwise: hex={hx}, bin={bn}, sep={mil}, and={bAnd}, or={bOr}, xor={bXor}, shl={bShl}, shr={bShr}")

    dim e1 = ExprItem.number(NumberLit(val=42))
    dim e2 = ExprItem.binary(BinaryOpNode(op="add", left=10, right=20))
    dim e3 = ExprItem.label("start")
    dim e4 = ExprItem.empty(0)
    print("Union kinds & match: " & evalExprItem(e1) & " | " & evalExprItem(e2) & " | " & evalExprItem(e3) & " | " & evalExprItem(e4))
end fn

fn lookupK(d as dict[str, int]) as int
    return d["k"] + d.get("missing", 0)
end fn

fn describeMethod(m as HttpMethod) as str
    select case m
        case HttpMethod.get
            return "GET"
        case HttpMethod.post, HttpMethod.put
            return "MUTATE"
        case else
            return "OTHER"
    end select
end fn

fn testEnums()
    dim m = HttpMethod.post
    print("HttpMethod.post toStr: " & m.toStr() & ", toInt: " & m.toInt().toStr())

    dim fa = FileAccess.readWrite
    print("FileAccess.readWrite: " & fa.toInt().toStr())

    print("describeMethod GET: " & describeMethod(HttpMethod.get))
    print("describeMethod POST: " & describeMethod(HttpMethod.post))
    print("describeMethod DELETE: " & describeMethod(HttpMethod.delete))
end fn

fn testBytesBuffers() can error
    dim gif = b"GIF89a"
    print("GIF magic len: " & gif.len().toStr() & ", hex: " & gif.toHex())

    dim part1 = gif.slice(0, 3)
    dim part2 = gif.sliceFrom(3)
    dim s1 = part1.toUtf8()
    dim s2 = part2.toUtf8()
    print("GIF slice: " & s1 & ", sliceFrom: " & s2)

    dim parsed = bytes.fromHex("deadbeef")
    dim parsedViaStr = "deadbeef".fromHex()
    if parsedViaStr.toHex() == parsed.toHex()
        print("fromHex: " & parsed.toHex() & ", len: " & parsed.len().toStr())
    end if

    dim originalStr = "CleanBasic"
    dim encoded = originalStr.toBytes()
    dim decodedStr = encoded.toUtf8()
    print("toBytes roundtrip: " & decodedStr)

    dim overlongRejected = false
    try
        dim badOverlong = b"\xc0\x80".toUtf8()
        print(badOverlong)
    catch e
        overlongRejected = true
    end try
    dim surrogateRejected = false
    try
        dim badSurrogate = b"\xed\xa0\x80".toUtf8()
        print(badSurrogate)
    catch e
        surrogateRejected = true
    end try
    print($"Invalid UTF-8 rejected: overlong={overlongRejected}, surrogate={surrogateRejected}")
    dim endianBuf as bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00"
    endianBuf.writeU16Le(4660, 0)
    endianBuf.writeU16Be(4660, 2)
    endianBuf.writeU32Le(287454020, 4)

    dim rU16Le = endianBuf.readU16Le(0)
    dim rU16Be = endianBuf.readU16Be(2)
    dim rU32Le = endianBuf.readU32Le(4)
    print("Endian U16Le: " & rU16Le.toStr() & ", U16Be: " & rU16Be.toStr() & ", U32Le: " & rU32Le.toStr())
end fn

fn testBinaryFiles() can error
    dim binPath = "build/testArtifacts/enumsAndBytes.dat"
    if fs.exists(binPath)
        fs.remove(binPath)
    end if

    dim testData = b"\xde\xad\xbe\xef\x01\x02\x03\x04"
    fs.writeBytes(binPath, testData)

    dim readBack = fs.readBytes(binPath)
    dim matches = (readBack.toHex() == testData.toHex())
    print("Whole file bytes match: " & matches.toStr())

    fs.remove(binPath)

    dim streamPath = "build/testArtifacts/enumsAndBytesStream.dat"
    if fs.exists(streamPath)
        fs.remove(streamPath)
    end if

    dim writer = fs.openMode(streamPath, "w")
    defer
        writer.close()
    end defer
    writer.writeFileBytes(b"\xaa\xbb\xcc\xdd")
    writer.close()

    dim reader = fs.open(streamPath)
    defer
        reader.close()
    end defer
    dim chunk1 = reader.readFileBytes(2)
    dim chunk2 = reader.readFileBytes(2)
    reader.close()

    print("Streamed bytes match: " & chunk1.toHex() & " and " & chunk2.toHex())
    fs.remove(streamPath)
end fn

fn main() as int
    try
        testEnums()
        testBytesBuffers()
        testBinaryFiles()
        testNumericsBitwiseAndUnions()
        dim m = HttpMethod.post
        dim a = 10
        dim b = 20
        print($"Interp basic: Method={m}, code={m.toInt()}, sum={a + b}, ok={a < b and b == 20}")
        print($"Interp braces & nested: {{{m}: {100 * 2}}} / {$"dict={lookupK({"k": 42})}"}")
        return 0
    catch e
        print("Error: " & e.msg)
        return 1
    end try
end fn
