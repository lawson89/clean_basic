' EXPECT_CPP: #include "
' EXPECT_CPP: fs_bridge.hpp"
' EXPECT_CPP: cb_std_fs__write(
' EXPECT_CPP: cb_std_fs__stdin(
' EXPECT_CPP: cb_std_fs__stdout(
' EXPECT_CPP: cb_std_fs__stderr(
' EXPECT_CPP: cb_std_fs__open(
' EXPECT_CPP: cb_std_fs__close(
' EXPECT_CPP: cb_std_fs__rename(
' EXPECT_CPP: cb_std_fs__removeAll(
' EXPECT_CPP: cb_std_fs__absPath(
' EXPECT_CPP: cb_std_fs__tempDir(
' EXPECT_OUT: Path helpers: dir=build/testArtifacts/stdlibFsSandbox, file=notes.txt, ext=.txt
' EXPECT_OUT: Whole-file lines=3, first=alpha, copiedSize=18, renamedExists=true
' EXPECT_OUT: Streamed lines=3: [L1] [L2] [L3], eofAfter=true
' EXPECT_OUT: WalkFiles count=3, allWithHidden=5, bytes=32, first=build/testArtifacts/stdlibFsSandbox/nested/deep.txt
' EXPECT_OUT: Directory entries=3: nested, renamed.txt
' EXPECT_OUT: AbsPath leaf=stdlibFsSandbox, tempDirValid=true
' EXPECT_OUT: Caught missing file (code=404), nonEmptyRemoveRejected=true
' EXPECT_OUT: Stdout stream write: hello via fs.stdout
' EXPECT_OUT: StdStreams: open=true/true/true, outEof=true, writeStdinErr=400, readStdoutErr=400, closedAfter=false/false/false, reopened=true
' EXPECT_OUT: Cleanup complete: removedAll=true, exists=false

import "std/fs"

fn testWholeFileAndCopy(baseDir as str) can error
    dim notesPath = fs.joinPath(baseDir, "notes.txt")
    dim copyPath = fs.joinPath(baseDir, "copy.txt")
    dim renamedPath = fs.joinPath(baseDir, "renamed.txt")

    print("Path helpers: dir=" & fs.parentDir(notesPath) & ", file=" & fs.fileName(notesPath) & ", ext=" & fs.ext(notesPath))

    fs.write(notesPath, "alpha\r\nbeta\n")
    fs.append(notesPath, "gamma\n")
    fs.copy(notesPath, copyPath)
    fs.rename(copyPath, renamedPath)

    dim allLines = fs.lines(notesPath)
    dim copiedSz = fs.size(renamedPath)
    dim renamedOk = (not fs.exists(copyPath)) and fs.isFile(renamedPath)
    if fs.exists(notesPath) and renamedOk
        print("Whole-file lines=" & allLines.len() & ", first=" & allLines[0] & ", copiedSize=" & copiedSz & ", renamedExists=" & renamedOk)
    end if

    fs.remove(notesPath)
end fn

fn testStreamingFile(baseDir as str) can error
    dim logPath = fs.joinPath(baseDir, "stream.log")

    dim writer = fs.openMode(logPath, "w")
    defer
        writer.close()
    end defer
    writer.writeLine("L1")
    writer.writeStr("L2\r\n")
    writer.flush()
    writer.close()

    dim appender = fs.openMode(logPath, "a")
    defer
        appender.close()
    end defer
    appender.writeLine("L3")
    appender.close()

    dim reader = fs.open(logPath)
    defer
        reader.close()
    end defer

    dim count = 0
    dim summary = ""
    dim line = ""
    while true
        dim hasLine = reader.readLine(line)
        if not hasLine
            break
        end if
        count = count + 1
        summary = summary & " [" & line & "]"
    end while

    dim atEof = reader.eof()
    print("Streamed lines=" & count & ":" & summary & ", eofAfter=" & atEof)
end fn

fn testWalkFiles(baseDir as str) can error
    dim nestedDir = fs.joinPath(baseDir, "nested")
    fs.mkdir(nestedDir)
    fs.write(fs.joinPath(nestedDir, "deep.txt"), "deep")

    dim hiddenFile = fs.joinPath(baseDir, ".hidden.txt")
    fs.write(hiddenFile, "secret")
    dim hiddenDir = fs.joinPath(baseDir, ".hiddenDir")
    fs.mkdir(hiddenDir)
    fs.write(fs.joinPath(hiddenDir, "inside.txt"), "secret2")

    dim visibleCount = 0
    dim totalVisibleBytes = 0
    dim firstVisible = ""
    dim walkedPaths = fs.walkFiles(baseDir)
    for path in walkedPaths
        if visibleCount == 0
            firstVisible = path
        end if
        visibleCount += 1
        dim fileSize = fs.size(path)
        totalVisibleBytes += fileSize
    end for

    dim allFiles = fs.walkFiles(baseDir, includeHidden=true)
    fs.remove(hiddenFile)
    fs.removeAll(hiddenDir)

    ' We expect visible: nested/deep.txt (4), renamed.txt (18), stream.log (10) -> 3 files, 32 bytes; allFiles -> 5 files
    print("WalkFiles count=" & visibleCount & ", allWithHidden=" & allFiles.len() & ", bytes=" & totalVisibleBytes & ", first=" & firstVisible)
end fn

fn testMissingFile(baseDir as str)
    dim nonEmptyRejected = false
    try
        fs.remove(baseDir)
    catch e
        nonEmptyRejected = true
    end try
    try
        dim missing = fs.joinPath(baseDir, "doesNotExist.txt")
        dim content = fs.read(missing)
        print(content)
    catch e
        print("Caught missing file (code=" & e.code & "), nonEmptyRemoveRejected=" & nonEmptyRejected)
        return
    end try
end fn

fn tryWriteToStdin() as int
    try
        dim inStream = fs.stdin()
        inStream.writeLine("cannot write to stdin")
        return 0
    catch e
        return e.code
    end try
end fn

fn tryReadFromStdout() as int
    try
        dim outStream = fs.stdout()
        dim line = ""
        outStream.readLine(line)
        return 0
    catch e
        return e.code
    end try
end fn

fn writeBannerToStream(out as fs.File, msg as str) can error
    out.writeStr("Stdout stream write: ")
    out.writeStr("he")
    out.writeLine(msg)
    out.flush()
end fn

fn testStandardStreams() can error
    dim inStream = fs.stdin()
    dim outStream = fs.stdout()
    dim errStream = fs.stderr()

    dim initInOpen = inStream.isOpen()
    dim initOutOpen = outStream.isOpen()
    dim initErrOpen = errStream.isOpen()
    dim outEof = outStream.eof() and errStream.eof()

    inStream.flush()
    writeBannerToStream(outStream, "llo via fs.stdout")
    errStream.flush()

    dim writeStdinErr = tryWriteToStdin()
    dim readStdoutErr = tryReadFromStdout()

    inStream.close()
    outStream.close()
    errStream.close()

    dim freshOut = fs.stdout()
    print("StdStreams: open=" & initInOpen & "/" & initOutOpen & "/" & initErrOpen & ", outEof=" & outEof & ", writeStdinErr=" & writeStdinErr & ", readStdoutErr=" & readStdoutErr & ", closedAfter=" & inStream.isOpen() & "/" & outStream.isOpen() & "/" & errStream.isOpen() & ", reopened=" & freshOut.isOpen())
end fn

fn main() as int
    try
        dim baseDir = "build/testArtifacts/stdlibFsSandbox"
        if fs.exists(baseDir)
            fs.removeAll(baseDir)
        end if
        fs.mkdir(baseDir)

        testWholeFileAndCopy(baseDir)
        testStreamingFile(baseDir)
        testWalkFiles(baseDir)

        if fs.isDir(baseDir)
            dim entries = fs.dir(baseDir)
            print("Directory entries=" & entries.len() & ": " & entries[0] & ", " & entries[1])
        end if

        dim absBase = fs.absPath(baseDir)
        dim tmpDir = fs.tempDir()
        print("AbsPath leaf=" & fs.fileName(absBase) & ", tempDirValid=" & (tmpDir.len() > 0 and fs.isDir(tmpDir)))

        testMissingFile(baseDir)
        testStandardStreams()

        dim removedCount = fs.removeAll(baseDir)
        print("Cleanup complete: removedAll=" & (removedCount >= 3) & ", exists=" & fs.exists(baseDir))
        return 0
    catch e
        print("Unexpected error: " & e.msg)
        return 1
    end try
end fn
