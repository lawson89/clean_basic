' EXPECT_CPP: #include "
' EXPECT_CPP: os_bridge.hpp"
' EXPECT_CPP: cb_std_os__args(
' EXPECT_CPP: cb_std_os__cwd(
' EXPECT_CPP: cb_std_os__clock(
' EXPECT_CPP: cb_std_os__exec(
' EXPECT_CPP: int main(int argc, char** argv)
' EXPECT_OUT: Args count=1
' EXPECT_OUT: Platform valid=true, exePathNonEmpty=true, unsetEnvExists=false, unsetEnvVal=[]
' EXPECT_OUT: Working dir changed=stdlibOsSandbox, restored=true
' EXPECT_OUT: Clock monotonic=true
' EXPECT_OUT: Subprocess exit codes: zero=0, seven=7
' EXPECT_OUT: Exec captured=CleanBasicExecOk
' EXPECT_OUT: Caught exec failure (code=9)
' EXPECT_OUT: Raw framing: Content-Length: 4 | readExact0=[]
' EXPECT_OUT: Stderr message via eprint

import "std/os"
import "std/fs"
import "std/str"

fn testChdirRoundtrip(sandboxDir as str) can error
    dim origCwd = os.cwd()
    os.chdir(sandboxDir)
    defer
        os.chdir(origCwd)
    end defer
    dim insideCwd = os.cwd()
    print("Working dir changed=" & fs.fileName(insideCwd) & ", restored=" & (origCwd != insideCwd))
end fn

fn testExecFailure()
    try
        dim badOut = os.exec("exit 9")
        print(badOut)
    catch e
        print($"Caught exec failure (code={e.code})")
        return
    end try
end fn

fn main() as int
    try
        dim argv = os.args()
        print("Args count=" & argv.len())

        dim plat = os.platform()
        dim platOk = (plat == "linux" or plat == "macos" or plat == "windows")
        dim exeP = os.exePath()
        dim exeOk = (exeP.len() > 0 and fs.exists(exeP))
        dim hasUnset = os.hasEnv("CB_NONEXISTENT_ENV_VAR_999")
        dim unsetVal = os.env("CB_NONEXISTENT_ENV_VAR_999")
        print("Platform valid=" & platOk & ", exePathNonEmpty=" & exeOk & ", unsetEnvExists=" & hasUnset & ", unsetEnvVal=[" & unsetVal & "]")

        dim sandboxDir = "build/testArtifacts/stdlibOsSandbox"
        if not fs.exists(sandboxDir)
            fs.mkdir(sandboxDir)
        end if
        testChdirRoundtrip(sandboxDir)
        fs.remove(sandboxDir)

        dim t0 = os.clock()
        os.sleep(5)
        dim t1 = os.clock()
        print("Clock monotonic=" & (t1 >= t0 and t0 >= 0))

        dim rc0 = os.run("exit 0")
        dim rc7 = os.run("exit 7")
        print("Subprocess exit codes: zero=" & rc0 & ", seven=" & rc7)

        dim execOut = os.exec("echo CleanBasicExecOk")
        print("Exec captured=" & execOut.trim())
        testExecFailure()

        os.printRaw("Raw framing: ")
        os.printRaw("Content-Length: 4")
        dim emptyExact = os.readExact(0)
        print(" | readExact0=[" & emptyExact & "]")
        os.eprintRaw("Stderr message ")
        os.eprint("via eprint")
        return 0
    catch e
        print("Unexpected error: " & e.msg)
        return 1
    end try
end fn
