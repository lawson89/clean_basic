' EXPECT_CPP: void*
' EXPECT_CPP: get_handle()
' EXPECT_CPP: use_handle(handle)
' FORBID_CPP: std::shared_ptr
' EXPECT_OUT: done

import header "../../../tests/cases/cptr_interop.hpp"

extern fn get_handle() as cptr
extern fn use_handle(h as cptr)

fn main()
    dim handle as cptr = get_handle()
    use_handle(handle)
    print("done")
end fn
