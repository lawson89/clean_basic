' EXPECT_CPP: int64_t testContainers(const std::vector<int64_t>& nums, const std::unordered_map<std::string, int64_t>& lookup)
' EXPECT_CPP: static_cast<int64_t>(nums.size())
' FORBID_CPP: std::list
' EXPECT_OUT: first: 10
' EXPECT_OUT: empty: 0
' EXPECT_OUT: score: 42
' EXPECT_OUT: hasAlice: true, hasCharlie: false, popped: 30, removedBob: true, afterClear: 0

fn testContainers(nums as list[int], lookup as dict[str, int]) as int
    select case nums.len()
    case 0
        return 0
    case else
        return nums[0]
    end select
end fn

fn main()
    dim nums as list[int] = [10, 20, 30]
    dim emptyNums as list[int] = []
    dim scores as dict[str, int] = {"alice": 42, "bob": 17}

    print("first: " & testContainers(nums, scores))
    print("empty: ", testContainers(emptyNums, scores))
    print("score: " & scores["alice"])

    dim hasAlice = scores.has("alice")
    dim hasCharlie = scores.has("charlie")
    dim popped = nums.pop()
    dim removedBob = scores.remove("bob")
    nums.clear()
    scores.clear()
    print($"hasAlice: {hasAlice}, hasCharlie: {hasCharlie}, popped: {popped}, removedBob: {removedBob}, afterClear: {nums.len() + scores.len()}")
end fn
