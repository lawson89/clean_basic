' EXPECT_CPP: int64_t testContainers(const std::vector<int64_t>& nums, const std::unordered_map<std::string, int64_t>& lookup)
' EXPECT_CPP: static_cast<int64_t>(nums.size())
' EXPECT_CPP: cbListSlice(
' EXPECT_CPP: cbListSort(
' EXPECT_CPP: cbDictKeys(
' EXPECT_CPP: cbListPop(
' EXPECT_CPP: cbBytesPop(
' EXPECT_CPP: continue;
' EXPECT_CPP: case 1:
' EXPECT_CPP: case 2:
' EXPECT_CPP: case 3: {
' EXPECT_CPP: default: {
' EXPECT_CPP: const auto _sel_
' FORBID_CPP: std::list
' EXPECT_OUT: first: 10
' EXPECT_OUT: empty: 0
' EXPECT_OUT: score: 42
' EXPECT_OUT: hasAlice: true, hasCharlie: false, popped: 30, removedBob: true, afterClear: 0
' EXPECT_OUT: sorted: 5,20,40,0, contains20: true, contains99: false, slice: 10,20, sliceFrom: 20,40, removedAt1: 10, afterRemoveLen: 3
' EXPECT_OUT: keys: alpha,beta,gamma,
' EXPECT_OUT: arenaSummary: node0_line=12, hasX=true, tagX=99, valsLen=2, totalVals=35
' EXPECT_OUT: classify: small|medium|large, str: 1|2|0
' EXPECT_OUT: continueSum: for=12, while=13, bytesPop=99, emptyRet=0:0
' EXPECT_OUT: indexed: 0:alice|1:bob|, bytesSum=132

type NodeEntry
    line as int
    vals as list[int]
    tags as dict[str, int]
end type

type NodeArena
    nodes as list[NodeEntry]
    modules as dict[str, dict[str, str]]
end type

fn bumpNode(byref n as NodeEntry, extra as int)
    n.line += extra
    n.vals.push(extra)
end fn

fn inspectReadOnlyArena(arena as NodeArena) as str
    dim totalVals = 0
    for node in arena.nodes
        for v in node.vals
            totalVals += v
        end for
    end for
    dim n0Line = arena.nodes[0].line
    dim hasX = arena.nodes[0].tags.has("x")
    dim tagX = arena.nodes[0].tags["x"]
    dim valsLen = arena.nodes[0].vals.len()
    return $"node0_line={n0Line}, hasX={hasX}, tagX={tagX}, valsLen={valsLen}, totalVals={totalVals}"
end fn

fn testContainers(nums as list[int], lookup as dict[str, int]) as int
    select case nums.len()
        case 0
            return 0
        case else
            return nums[0]
    end select
end fn

fn classifyInt(n as int) as str
    select case n
        case 1, 2, 3
            return "small"
        case 4, 5
            return "medium"
        case else
            return "large"
    end select
end fn

fn classifyStr(s as str) as int
    select case s
        case "apple", "banana"
            return 1
        case "cherry"
            return 2
        case else
            return 0
    end select
end fn

fn makeEmptyList() as list[int]
    return []
end fn

fn makeEmptyDict() as dict[str, int]
    return {}
end fn

fn testContinueAndEmptyInference()
    dim forSum = 0
    for i = 1 to 5
        if i == 3
            continue
        end if
        forSum += i
    end for

    dim n = 0
    dim whileSum = 0
    while n < 5
        n += 1
        if n == 2
            continue
        end if
        whileSum += n
    end while

    dim buf = b"abc"
    dim lastByte = buf.pop()
    buf.clear()

    dim el = makeEmptyList()
    dim ed = makeEmptyDict()
    el = []
    ed = {}
    print($"continueSum: for={forSum}, while={whileSum}, bytesPop={lastByte}, emptyRet={el.len()}:{ed.len()}")
end fn

fn testIndexedLoops()
    dim names as list[str] = ["alice", "bob"]
    dim nameOut = ""
    for i, name in names
        nameOut &= $"{i}:{name}|"
    end for

    dim raw = b"AB"
    dim bytesSum = 0
    for idx, b in raw
        bytesSum += idx + b
    end for
    print($"indexed: {nameOut}, bytesSum={bytesSum}")
end fn

fn main()
    dim nums as list[int] = [10, 20, 30]
    dim emptyNums as list[int] = []
    dim scores as dict[str, int] = {"alice": 42, "bob": 17}

    print("first: " & testContainers(nums, scores))
    print("empty: ", testContainers(emptyNums, scores))
    print("score: " & scores["alice"])

    dim hasAlice = scores.has("alice")
    dim hasCharlie = scores.has("charlie")
    dim popped = nums.pop()
    dim removedBob = scores.remove("bob")
    nums.clear()
    scores.clear()
    print($"hasAlice: {hasAlice}, hasCharlie: {hasCharlie}, popped: {popped}, removedBob: {removedBob}, afterClear: {nums.len() + scores.len()}")

    dim items as list[int] = [40, 10, 5, 20]
    items.sort()
    dim sub1 = items.slice(1, 3)
    dim sub2 = items.sliceFrom(2)
    dim c20 = items.contains(20)
    dim c99 = items.contains(99)
    dim rem1 = items.removeAt(1)
    print($"sorted: {items[0]},{items[1]},{items[2]},{items[3]}, contains20: {c20}, contains99: {c99}, slice: {sub1[0]},{sub1[1]}, sliceFrom: {sub2[0]},{sub2[1]}, removedAt1: {rem1}, afterRemoveLen: {items.len()}")

    dim d as dict[str, int] = {"gamma": 3, "alpha": 1, "beta": 2}
    dim kout = ""
    for k in d.keys()
        kout &= k & ","
    end for
    print("keys: " & kout)

    dim arena = NodeArena()
    arena.nodes.push(NodeEntry(line=2, vals=[25], tags={"x": 10}))
    arena.nodes[0].tags["x"] = 99
    arena.modules["root"]["hero"] = "entities/hero"
    bumpNode(arena.nodes[0], 10)
    print("arenaSummary: " & inspectReadOnlyArena(arena))

    print($"classify: {classifyInt(2)}|{classifyInt(5)}|{classifyInt(9)}, str: {classifyStr("banana")}|{classifyStr("cherry")}|{classifyStr("pear")}")
    testContinueAndEmptyInference()
    testIndexedLoops()
end fn
