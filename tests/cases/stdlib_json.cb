' EXPECT_CPP: #include "
' EXPECT_CPP: json_bridge.hpp"
' EXPECT_CPP: cb_std_json__parse(
' EXPECT_CPP: cb_std_json__stringify(
' EXPECT_OUT: Built JSON: {"service":"cleanbasic","port":8080,"enabled":true,"items":[10,20],"meta":null}
' EXPECT_OUT: Parsed service: cleanbasic (port=8080, enabled=true, items=2, firstItem=10)
' EXPECT_OUT: Caught invalid JSON (code=400)

import "std/json"

fn buildPayload() as str
    dim doc = json.newDoc()
    dim root = doc.newObject()
    doc.objectSet(root, "service", doc.newStr("cleanbasic"))
    doc.objectSet(root, "port", doc.newInt(8080))
    doc.objectSet(root, "enabled", doc.newBool(true))

    dim items = doc.newArray()
    doc.arrayPush(items, doc.newInt(10))
    doc.arrayPush(items, doc.newInt(20))
    doc.objectSet(root, "items", items)
    doc.objectSet(root, "meta", doc.newNull())

    doc.setRoot(root)
    return doc.stringify()
end fn

fn inspectPayload(payload as str) can error
    dim doc = json.parse(payload)
    dim root = doc.root()

    dim svcVal = doc.getField(root, "service")
    dim svcName = doc.getStr(svcVal)

    dim portVal = doc.getField(root, "port")
    dim portNum = doc.getInt(portVal)

    dim enabledVal = doc.getField(root, "enabled")
    dim isEnabled = doc.getBool(enabledVal)

    dim itemsVal = doc.getField(root, "items")
    dim itemCount = doc.arrayLen(itemsVal)
    dim firstItemVal = doc.arrayAt(itemsVal, 0)
    dim firstItem = doc.getInt(firstItemVal)

    dim metaVal = doc.getField(root, "meta")
    if doc.isNull(metaVal) and doc.hasField(root, "service")
        print("Parsed service: " & svcName & " (port=" & portNum & ", enabled=" & isEnabled & ", items=" & itemCount & ", firstItem=" & firstItem & ")")
    end if
end fn

fn testBadJson()
    on error e
        print("Caught invalid JSON (code=" & e.code & ")")
        return
    end error

    dim bad = json.parse("{brokenJson:")
    print(bad.stringify())
end fn

fn main() as int
    on error e
        print("Unexpected error: " & e.msg)
        return 1
    end error

    dim payload = buildPayload()
    print("Built JSON: " & payload)
    inspectPayload(payload)
    testBadJson()
    return 0
end fn
