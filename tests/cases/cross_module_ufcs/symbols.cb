import "ast.cb"

public fn makeCfg(s as int) as ast.SharedCfg
    return ast.SharedCfg(scale=s)
end fn

public fn resolveAlias(arena as ast.AstArena, tid as int) as str
    return arena.types[tid]
end fn

public fn resolveAliasOr(arena as ast.AstArena, tid as int, fallback as str) as str
    if tid < 0 or tid >= arena.types.len()
        return fallback
    end if
    return arena.types[tid]
end fn
