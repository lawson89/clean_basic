' Regression tests for fixes
' EXPECT_CPP: auto [_val1, _err1] = connect(std::string("127.0.0.1"));
' EXPECT_CPP: CbError _err2 = voidFallible();
' EXPECT_CPP: if (cbHasError(_err2)) {
' EXPECT_CPP: return _err2;
' EXPECT_CPP: void overload(int64_t x) {
' EXPECT_CPP: int64_t local = 10;
' EXPECT_CPP: void overload(const std::string& x) {
' EXPECT_CPP: std::string local = std::string("hi");
' EXPECT_OUT: Connect success
' EXPECT_OUT: Void fallible success
' EXPECT_OUT: Overload int: 10
' EXPECT_OUT: Overload str: hi
' EXPECT_OUT: Enum assignment success

pub enum Status
    Active = 1
    Inactive = 2
end enum

pub type State
    val as Status
end type

fn connect(ip as str) as int can error
    if ip == ""
        error("Empty IP")
    end if
    return 1
end fn

fn voidFallible() can error
    ' Do nothing
end fn

fn testReturnFallible() can error
    dim x = connect("127.0.0.1")
    return voidFallible()
end fn

fn overload(x as int)
    dim local = 10
    print("Overload int: ", local)
end fn

fn overload(x as str)
    dim local = "hi"
    print("Overload str: ", local)
end fn

fn main() as int
    try
        testReturnFallible()
        print("Connect success")
        print("Void fallible success")

        overload(1)
        overload("test")

        dim s = State(val=Status.Active)
        s.val = Status.Inactive
        
        dim l as list[Status] = [Status.Active]
        l[0] = Status.Inactive
        
        print("Enum assignment success")
        return 0
    catch e
        print("Error: ", e.msg)
        return 1
    end try
end fn
